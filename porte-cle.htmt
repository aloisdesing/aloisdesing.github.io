<!DOCTYPE html>
<html lang="fr">
<head>

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Porte-clé personnalisé | Aloïs Design</title>

  <meta
    name="description"
    content="Créez votre porte-clé personnalisé avec Aloïs Design."
  >

  <style>

    :root {
      --bg: #090909;
      --bg-light: #121212;
      --card: #171717;
      --gold: #d9a72b;
      --gold-light: #f3cc68;
      --white: #ffffff;
      --gray: #aaaaaa;
      --border: #292929;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: var(--bg);
      color: var(--white);
      line-height: 1.6;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .container {
      width: min(1120px, 92%);
      margin: auto;
    }

    /* =========================
       HEADER
    ========================== */

    header {
      position: sticky;
      top: 0;
      z-index: 100;

      background: rgba(9, 9, 9, 0.96);

      backdrop-filter: blur(12px);

      border-bottom: 1px solid var(--border);
    }

    nav {
      min-height: 72px;

      display: flex;
      align-items: center;
      justify-content: space-between;

      gap: 15px;
    }

    .logo {
      font-size: 20px;
      font-weight: 900;

      letter-spacing: 2px;

      color: var(--gold);

      white-space: nowrap;
    }

    .logo span {
      color: white;
    }

    .nav-links {
      display: flex;
      align-items: center;

      gap: 20px;

      font-size: 14px;

      color: #ddd;
    }

    .nav-links a:hover {
      color: var(--gold-light);
    }

    /* =========================
       PANIER
    ========================== */

    .cart-link {
      position: relative;

      display: flex;
      align-items: center;
      justify-content: center;

      width: 42px;
      height: 42px;

      border: 1px solid #333;

      border-radius: 10px;

      background: #111;

      transition: 0.2s;
    }

    .cart-link:hover {
      border-color: var(--gold);
      transform: translateY(-2px);
    }

    .cart-icon {
      width: 25px;
      height: 25px;

      fill: none;

      stroke: var(--gold-light);

      stroke-width: 2;

      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .cart-count {
      position: absolute;

      top: -7px;
      right: -7px;

      min-width: 20px;
      height: 20px;

      padding: 2px 5px;

      border-radius: 50%;

      background: var(--gold);

      color: #111;

      font-size: 11px;

      font-weight: 900;

      text-align: center;
    }

    /* =========================
       BOUTONS
    ========================== */

    .btn {
      display: inline-block;

      padding: 13px 20px;

      border-radius: 10px;

      background: var(--gold);

      border: 1px solid var(--gold);

      color: #111;

      font-weight: 900;

      cursor: pointer;

      transition: 0.2s;
    }

    .btn:hover {
      background: var(--gold-light);
      border-color: var(--gold-light);
    }

    .btn-secondary {
      background: transparent;

      border-color: #444;

      color: white;
    }

    .btn-secondary:hover {
      border-color: var(--gold);

      color: var(--gold-light);

      background: transparent;
    }

    /* =========================
       HERO
    ========================== */

    .hero {
      padding: 110px 0 90px;

      background:
        radial-gradient(
          circle at 80% 20%,
          #30240c 0,
          transparent 35%
        );
    }

    .kicker {
      color: var(--gold-light);

      text-transform: uppercase;

      letter-spacing: 2px;

      font-size: 13px;

      font-weight: 800;

      margin-bottom: 15px;
    }

    .hero h1 {
      font-size: clamp(42px, 7vw, 72px);

      line-height: 1.02;

      max-width: 850px;

      margin-bottom: 22px;
    }

    .hero h1 span {
      color: var(--gold);
    }

    .hero p {
      max-width: 730px;

      color: var(--gray);

      font-size: 19px;
    }

    .hero-buttons {
      display: flex;

      flex-wrap: wrap;

      gap: 12px;

      margin-top: 30px;
    }

    /* =========================
       SECTIONS
    ========================== */

    section {
      padding: 80px 0;
    }

    .section-title {
      margin-bottom: 40px;
    }

    .section-title.center {
      text-align: center;
    }

    .section-title h2 {
      font-size: clamp(30px, 4vw, 44px);

      line-height: 1.1;

      margin-bottom: 10px;
    }

    .section-title p {
      color: var(--gray);
    }

    /* =========================
       CARTES
    ========================== */

    .grid {
      display: grid;

      grid-template-columns: repeat(2, 1fr);

      gap: 20px;
    }

    .card {
      padding: 30px;

      border: 1px solid var(--border);

      background:
        linear-gradient(
          145deg,
          #181818,
          #101010
        );

      border-radius: 18px;
    }

    .card:hover {
      border-color: #4a3a15;

      transform: translateY(-4px);
    }

    .card h3 {
      font-size: 24px;

      color: var(--gold-light);

      margin-bottom: 10px;
    }

    .card p {
      color: var(--gray);

      margin-bottom: 20px;
    }

    .card ul {
      list-style: none;
    }

    .card li {
      margin: 9px 0;

      color: #ddd;
    }

    .card li::before {
      content: "✓";

      color: var(--gold-light);

      font-weight: bold;

      margin-right: 9px;
    }

    /* =========================
       PERSONNALISATION
    ========================== */

    .custom-box {
      background:
        linear-gradient(
          145deg,
          #171207,
          #0e0e0e
        );

      border-top: 1px solid #392c10;

      border-bottom: 1px solid #392c10;
    }

    .custom-content {
      display: grid;

      grid-template-columns: 1fr 1fr;

      gap: 25px;
    }

    .custom-info,
    .custom-form {
      padding: 30px;

      border: 1px solid var(--border);

      border-radius: 18px;

      background: #101010;
    }

    .custom-info h2 {
      font-size: 28px;

      color: var(--gold-light);

      margin-bottom: 12px;
    }

    .custom-info p {
      color: var(--gray);

      margin-bottom: 20px;
    }

    .custom-info ul {
      list-style: none;
    }

    .custom-info li {
      margin: 10px 0;

      color: #ddd;
    }

    .custom-info li::before {
      content: "✓";

      color: var(--gold);

      margin-right: 10px;
    }

    /* =========================
       FORMULAIRE
    ========================== */

    form label {
      display: block;

      margin: 12px 0 6px;

      font-size: 14px;

      color: #ddd;
    }

    input,
    select,
    textarea {
      width: 100%;

      padding: 12px;

      border-radius: 9px;

      border: 1px solid #333;

      background: #080808;

      color: white;

      font: inherit;
    }

    input:focus,
    select:focus,
    textarea:focus {
      outline: 1px solid var(--gold);

      border-color: var(--gold);
    }

    textarea {
      min-height: 120px;

      resize: vertical;
    }

    .small-text {
      font-size: 12px;

      color: #888;

      margin-top: 6px;
    }

    /* =========================
       PANIER
    ========================== */

    .cart-section {
      text-align: center;
    }

    .cart-box {
      padding: 40px;

      border: 1px solid var(--border);

      border-radius: 18px;

      background: var(--card);
    }

    .cart-box h2 {
      font-size: 30px;

      margin-bottom: 10px;
    }

    .cart-box p {
      color: var(--gray);

      margin-bottom: 25px;
    }

    /* =========================
       FOOTER
    ========================== */

    footer {
      border-top: 1px solid var(--border);

      padding: 35px 0;

      text-align: center;

      color: #888;

      font-size: 13px;
    }

    footer a {
      color: var(--gold-light);
    }

    /* =========================
       MOBILE
    ========================== */

    @media (max-width: 850px) {

      .nav-links {
        display: none;
      }

      .custom-content,
      .grid {
        grid-template-columns: 1fr;
      }

      .hero {
        padding-top: 75px;
      }

    }

    @media (max-width: 500px) {

      .container {
        width: 90%;
      }

      .hero h1 {
        font-size: 42px;
      }

      .hero p {
        font-size: 17px;
      }

      .hero-buttons {
        flex-direction: column;
      }

      .hero-buttons .btn {
        width: 100%;
        text-align: center;
      }

      section {
        padding: 60px 0;
      }

    }

  </style>

</head>


<body>


<!-- =========================
     HEADER
========================== -->

<header>

  <div class="container">

    <nav>

      <a
        href="index.html"
        class="logo"
      >
        ALOÏS <span>DESIGN</span>
      </a>


      <div class="nav-links">

        <a href="index.html">
          Accueil
        </a>

        <a href="impression-3d.html">
          Impression 3D
        </a>

        <a href="logo3D.html">
          Logo 3D
        </a>

        <a href="porte-clé.html">
          Porte-clé
        </a>

        <a href="tampons.html">
          Tampons
        </a>

      </div>


      <!-- PANIER -->

      <a
        href="panier.html"
        class="cart-link"
        aria-label="Voir le panier"
      >

        <svg
          class="cart-icon"
          viewBox="0 0 24 24"
        >

          <circle
            cx="9"
            cy="20"
            r="1.5"
          ></circle>

          <circle
            cx="18"
            cy="20"
            r="1.5"
          ></circle>

          <path
            d="M3 4h2l2.2 11.2a2 2 0 0 0 2 1.6h7.8a2 2 0 0 0 1.9-1.4L21 8H6"
          ></path>

        </svg>


        <span
          class="cart-count"
          id="cartCount"
        >
          0
        </span>

      </a>

    </nav>

  </div>

</header>



<main>


<!-- =========================
     HERO
========================== -->

<section class="hero">

  <div class="container">

    <div class="kicker">
      ALOÏS DESIGN
    </div>


    <h1>

      Porte-clé
      <span>personnalisé.</span>

    </h1>


    <p>

      Créez un porte-clé unique avec le dessin,
      le texte, le logo ou le motif de votre choix.

    </p>


    <div class="hero-buttons">

      <a
        href="#personnalisation"
        class="btn"
      >
        Personnaliser mon porte-clé
      </a>


      <a
        href="panier.html"
        class="btn btn-secondary"
      >
        🛒 Voir mon panier
      </a>

    </div>

  </div>

</section>



<!-- =========================
     INFORMATIONS
========================== -->

<section>

  <div class="container">

    <div class="section-title center">

      <h2>
        🔑 Votre porte-clé
      </h2>

      <p>
        Une petite création personnalisée réalisée en impression 3D.
      </p>

    </div>


    <div class="grid">


      <article class="card">

        <h3>
          🎨 Votre dessin
        </h3>

        <p>

          Vous pouvez nous envoyer le dessin
          ou le motif que vous souhaitez
          retrouver sur votre porte-clé.

        </p>

        <ul>

          <li>
            Logo
          </li>

          <li>
            Dessin
          </li>

          <li>
            Texte
          </li>

          <li>
            Motif personnalisé
          </li>

        </ul>

      </article>


      <article class="card">

        <h3>
          🖨️ Impression 3D
        </h3>

        <p>

          Votre modèle est préparé puis
          réalisé en impression 3D.

        </p>

        <ul>

          <li>
            Fabrication personnalisée
          </li>

          <li>
            Plusieurs couleurs possibles
          </li>

          <li>
            Modèle adapté à votre demande
          </li>

          <li>
            Fabrication sur commande
          </li>

        </ul>

      </article>


    </div>

  </div>

</section>



<!-- =========================
     PERSONNALISATION
========================== -->

<section
  class="custom-box"
  id="personnalisation"
>

  <div class="container">


    <div class="section-title center">

      <h2>
        Créez votre porte-clé
      </h2>

      <p>
        Expliquez-nous ce que vous souhaitez.
      </p>

    </div>


    <div class="custom-content">


      <!-- INFORMATIONS -->

      <div class="custom-info">

        <h2>
          Votre idée
        </h2>

        <p>

          Indiquez le dessin, le texte ou le
          logo que vous souhaitez utiliser.

        </p>


        <ul>

          <li>
            Décrivez votre modèle
          </li>

          <li>
            Indiquez la couleur souhaitée
          </li>

          <li>
            Indiquez la quantité
          </li>

          <li>
            Envoyez votre dessin si nécessaire
          </li>

        </ul>


        <p style="margin-top: 25px;">

          📩

          <a
            href="mailto:aloisryckebuschvandaele@gmail.com"
            style="
              color: var(--gold-light);
              font-weight: bold;
            "
          >
            aloisryckebuschvandaele@gmail.com
          </a>

        </p>

      </div>



      <!-- FORMULAIRE -->

      <div class="custom-form">

        <form
          action="mailto:aloisryckebuschvandaele@gmail.com"
          method="post"
          enctype="text/plain"
        >


          <label for="nom">
            Nom / prénom
          </label>

          <input
            type="text"
            id="nom"
            name="Nom / prénom"
            required
            placeholder="Votre nom et prénom"
          >


          <label for="email">
            Email
          </label>

          <input
            type="email"
            id="email"
            name="Email"
            required
            placeholder="Votre adresse e-mail"
          >


          <label for="texte">
            Texte ou inscription
          </label>

          <input
            type="text"
            id="texte"
            name="Texte"
            placeholder="Ex. Mon prénom"
          >


          <label for="couleur">
            Couleur souhaitée
          </label>

          <select
            id="couleur"
            name="Couleur"
          >

            <option value="">
              Choisir une couleur
            </option>

            <option value="Noir">
              Noir
            </option>

            <option value="Blanc">
              Blanc
            </option>

            <option value="Rouge">
              Rouge
            </option>

            <option value="Bleu">
              Bleu
            </option>

            <option value="Vert">
              Vert
            </option>

            <option value="Jaune">
              Jaune
            </option>

            <option value="Autre">
              Autre
            </option>

          </select>


          <label for="quantite">
            Quantité
          </label>

          <input
            type="number"
            id="quantite"
            name="Quantité"
            min="1"
            value="1"
          >


          <label for="description">
            Décrivez votre porte-clé
          </label>

          <textarea
            id="description"
            name="Description"
            required
            placeholder="Expliquez-nous le dessin ou le modèle que vous souhaitez..."
          ></textarea>


          <button
            type="submit"
            class="btn"
            style="
              margin-top: 20px;
              width: 100%;
              border: none;
            "
          >
            Envoyer ma demande
          </button>


          <p class="small-text">
            Votre demande sera envoyée par e-mail.
          </p>


        </form>

      </div>


    </div>

  </div>

</section>



<!-- =========================
     PANIER
========================== -->

<section class="cart-section">

  <div class="container">

    <div class="cart-box">

      <h2>
        🛒 Votre panier
      </h2>

      <p>

        Retrouvez ici vos produits sélectionnés.

      </p>

      <a
        href="panier.html"
        class="btn"
      >
        Ouvrir mon panier
      </a>

    </div>

  </div>

</section>



<!-- =========================
     RETOUR
========================== -->

<section>

  <div
    class="container"
    style="text-align: center;"
  >

    <a
      href="impression-3d.html"
      class="btn btn-secondary"
    >
      ← Retour à l'impression 3D
    </a>

  </div>

</section>


</main>



<!-- =========================
     FOOTER
========================== -->

<footer>

  <div class="container">

    <p>
      Aloïs Design
    </p>

    <p>
      Impression 3D · Création de logos ·
      Sculpture & gravure
    </p>

    <p style="margin-top: 10px;">

      <a
        href="mailto:aloisryckebuschvandaele@gmail.com"
      >
        aloisryckebuschvandaele@gmail.com
      </a>

    </p>

    <p style="margin-top: 10px;">
      © 2026 Aloïs Design
    </p>

  </div>

</footer>



<!-- =========================
     COMPTEUR PANIER
========================== -->

<script>

  function updateCartCount() {

    const cartCount =
      document.getElementById("cartCount");

    let panier = [];

    try {

      panier =
        JSON.parse(
          localStorage.getItem("panier")
        ) || [];

    } catch (error) {

      panier = [];

    }


    let total = 0;


    panier.forEach(function(produit) {

      total +=
        Number(produit.quantite) || 1;

    });


    cartCount.textContent = total;

  }


  updateCartCount();


  window.addEventListener(
    "storage",
    updateCartCount
  );

</script>


</body>
</html>
