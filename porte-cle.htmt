<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Porte-clé personnalisé | Aloïs Design</title>

  <meta
    name="description"
    content="Porte-clés personnalisés imprimés en 3D par Aloïs Design."
  >

  <style>
    :root {
      --bg: #090909;
      --bg-light: #121212;
      --card: #171717;
      --gold: #d9a72b;
      --gold-light: #f3cc68;
      --white: #ffffff;
      --gray: #aaaaaa;
      --border: #292929;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: var(--bg);
      color: white;
      line-height: 1.6;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .container {
      width: min(1120px, 92%);
      margin: auto;
    }

    /* HEADER */

    header {
      position: sticky;
      top: 0;
      z-index: 100;

      background: rgba(9, 9, 9, 0.96);
      backdrop-filter: blur(12px);

      border-bottom: 1px solid var(--border);
    }

    nav {
      min-height: 72px;

      display: flex;
      align-items: center;
      justify-content: space-between;

      gap: 15px;
    }

    .logo {
      font-size: 20px;
      font-weight: 900;
      letter-spacing: 2px;
      color: var(--gold);
      white-space: nowrap;
    }

    .logo span {
      color: white;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 18px;

      font-size: 14px;
      color: #ddd;
    }

    .nav-links a:hover {
      color: var(--gold-light);
    }

    /* PANIER */

    .cart-link {
      position: relative;

      width: 44px;
      height: 44px;

      display: flex;
      align-items: center;
      justify-content: center;

      border: 1px solid #333;
      border-radius: 10px;

      background: #111;
    }

    .cart-link:hover {
      border-color: var(--gold);
    }

    .cart-icon {
      width: 25px;
      height: 25px;

      fill: none;

      stroke: var(--gold-light);

      stroke-width: 2;

      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .cart-count {
      position: absolute;

      top: -7px;
      right: -7px;

      min-width: 20px;
      height: 20px;

      padding: 2px 5px;

      border-radius: 50%;

      background: var(--gold);

      color: #111;

      font-size: 11px;
      font-weight: 900;

      text-align: center;
    }

    /* HERO */

    .hero {
      padding: 90px 0 70px;

      background:
        radial-gradient(
          circle at 80% 20%,
          #30240c 0,
          transparent 35%
        );
    }

    .kicker {
      color: var(--gold-light);

      text-transform: uppercase;

      letter-spacing: 2px;

      font-size: 13px;
      font-weight: 800;

      margin-bottom: 12px;
    }

    .hero h1 {
      font-size: clamp(42px, 7vw, 70px);

      line-height: 1.05;

      margin-bottom: 18px;
    }

    .hero h1 span {
      color: var(--gold);
    }

    .hero p {
      max-width: 700px;

      color: var(--gray);

      font-size: 18px;
    }

    /* PRODUIT */

    .product-section {
      padding: 60px 0 90px;
    }

    .product-layout {
      display: grid;

      grid-template-columns: 1fr 1fr;

      gap: 30px;

      align-items: start;
    }

    .product-preview {
      min-height: 450px;

      display: flex;
      align-items: center;
      justify-content: center;

      border: 1px solid var(--border);

      border-radius: 20px;

      background:
        radial-gradient(
          circle,
          #211a0b 0,
          #111 55%,
          #0b0b0b 100%
        );
    }

    .keychain-icon {
      font-size: 150px;

      filter:
        drop-shadow(
          0 0 25px
          rgba(217,167,43,0.25)
        );
    }

    .product-info {
      padding: 32px;

      border: 1px solid var(--border);

      border-radius: 20px;

      background:
        linear-gradient(
          145deg,
          #181818,
          #101010
        );
    }

    .product-info h2 {
      font-size: 32px;

      margin-bottom: 8px;
    }

    .price {
      color: var(--gold-light);

      font-size: 28px;

      font-weight: 900;

      margin-bottom: 20px;
    }

    .description {
      color: var(--gray);

      margin-bottom: 25px;
    }

    /* OPTIONS */

    .option {
      margin-top: 18px;
    }

    .option label {
      display: block;

      color: #ddd;

      font-size: 14px;

      font-weight: 800;

      margin-bottom: 7px;
    }

    input,
    select,
    textarea {
      width: 100%;

      padding: 13px;

      border-radius: 9px;

      border: 1px solid #333;

      background: #080808;

      color: white;

      font: inherit;
    }

    input:focus,
    select:focus,
    textarea:focus {
      outline: 1px solid var(--gold);

      border-color: var(--gold);
    }

    textarea {
      min-height: 110px;

      resize: vertical;
    }

    .hint {
      color: #777;

      font-size: 12px;

      margin-top: 5px;
    }

    /* QUANTITÉ */

    .quantity {
      display: flex;

      align-items: center;

      gap: 10px;

      margin-top: 20px;
    }

    .quantity button {
      width: 38px;
      height: 38px;

      border-radius: 8px;

      border: 1px solid #444;

      background: #0b0b0b;

      color: white;

      font-size: 20px;

      cursor: pointer;
    }

    .quantity button:hover {
      border-color: var(--gold);

      color: var(--gold-light);
    }

    .quantity span {
      min-width: 40px;

      text-align: center;

      font-weight: 900;
    }

    /* BOUTON */

    .btn {
      width: 100%;

      display: block;

      padding: 15px 20px;

      margin-top: 25px;

      border-radius: 10px;

      border: 1px solid var(--gold);

      background: var(--gold);

      color: #111;

      font-weight: 900;

      text-align: center;

      cursor: pointer;

      transition: 0.2s;
    }

    .btn:hover {
      background: var(--gold-light);

      border-color: var(--gold-light);
    }

    .back {
      display: inline-block;

      margin-top: 18px;

      color: var(--gold-light);

      font-size: 14px;

      font-weight: 800;
    }

    /* INFORMATIONS */

    .information {
      margin-top: 30px;

      padding: 25px;

      border: 1px solid var(--border);

      border-radius: 18px;

      background: var(--bg-light);
    }

    .information h3 {
      color: var(--gold-light);

      margin-bottom: 12px;
    }

    .information ul {
      list-style: none;
    }

    .information li {
      margin: 8px 0;

      color: #ccc;
    }

    .information li::before {
      content: "✓";

      color: var(--gold);

      font-weight: 900;

      margin-right: 9px;
    }

    /* MESSAGE */

    .success {
      display: none;

      margin-top: 18px;

      padding: 14px;

      border: 1px solid #5a4515;

      border-radius: 10px;

      background: #181207;

      color: var(--gold-light);

      text-align: center;

      font-weight: 800;
    }

    /* FOOTER */

    footer {
      border-top: 1px solid var(--border);

      padding: 35px 0;

      text-align: center;

      color: #888;

      font-size: 13px;
    }

    .gold {
      color: var(--gold-light);
    }

    /* MOBILE */

    @media (max-width: 850px) {

      .nav-links {
        display: none;
      }

      .product-layout {
        grid-template-columns: 1fr;
      }

      .product-preview {
        min-height: 320px;
      }

    }

    @media (max-width: 500px) {

      .container {
        width: 90%;
      }

      .hero {
        padding-top: 70px;
      }

      .product-info {
        padding: 22px;
      }

      .keychain-icon {
        font-size: 110px;
      }

    }

  </style>
</head>

<body>

  <!-- HEADER -->

  <header>

    <div class="container">

      <nav>

        <a
          href="index.html"
          class="logo"
        >
          ALOÏS <span>DESIGN</span>
        </a>


        <div class="nav-links">

          <a href="index.html">
            Accueil
          </a>

          <a href="impression-3d.html">
            Impression 3D
          </a>

          <a href="Logo3D.html">
            Logo 3D
          </a>

          <a href="porte-cle.html">
            Porte-clé
          </a>

          <a href="tampons.html">
            Tampons
          </a>

          <a href="creation-logo.html">
            Création de logo
          </a>

        </div>


        <a
          href="panier.html"
          class="cart-link"
          aria-label="Voir le panier"
        >

          <svg
            class="cart-icon"
            viewBox="0 0 24 24"
          >

            <circle
              cx="9"
              cy="20"
              r="1.5"
            ></circle>

            <circle
              cx="18"
              cy="20"
              r="1.5"
            ></circle>

            <path
              d="M3 4h2l2.2 11.2a2 2 0 0 0 2 1.6h7.8a2 2 0 0 0 1.9-1.4L21 8H6"
            ></path>

          </svg>

          <span
            class="cart-count"
            id="cartCount"
          >
            0
          </span>

        </a>

      </nav>

    </div>

  </header>


  <main>

    <!-- HERO -->

    <section class="hero">

      <div class="container">

        <div class="kicker">
          Impression 3D personnalisée
        </div>

        <h1>
          Porte-clé <span>personnalisé.</span>
        </h1>

        <p>
          Créez votre porte-clé avec le texte,
          le prénom, le nom ou l'idée de votre choix.
        </p>

      </div>

    </section>


    <!-- PRODUIT -->

    <section class="product-section">

      <div class="container">

        <div class="product-layout">


          <!-- APERÇU -->

          <div class="product-preview">

            <div class="keychain-icon">
              🔑
            </div>

          </div>


          <!-- INFORMATIONS -->

          <div class="product-info">

            <h2>
              Porte-clé personnalisé
            </h2>

            <div class="price">
              6,00 €
            </div>

            <p class="description">
              Un porte-clé imprimé en 3D et personnalisé
              selon votre demande.
              Indiquez simplement ce que vous souhaitez
              voir dessus.
            </p>


            <!-- TEXTE -->

            <div class="option">

              <label for="keyText">
                Texte à mettre sur le porte-clé
              </label>

              <input
                type="text"
                id="keyText"
                maxlength="30"
                placeholder="Ex. Aloïs Design"
              >

              <div class="hint">
                Prénom, nom, entreprise, surnom...
              </div>

            </div>


            <!-- COULEUR -->

            <div class="option">

              <label for="keyColor">
                Couleur souhaitée
              </label>

              <select id="keyColor">

                <option value="Noir">
                  Noir
                </option>

                <option value="Blanc">
                  Blanc
                </option>

                <option value="Rouge">
                  Rouge
                </option>

                <option value="Bleu">
                  Bleu
                </option>

                <option value="Vert">
                  Vert
                </option>

                <option value="Jaune">
                  Jaune
                </option>

                <option value="Orange">
                  Orange
                </option>

                <option value="Autre">
                  Autre
                </option>

              </select>

            </div>


            <!-- DESSIN -->

            <div class="option">

              <label for="keyDescription">
                Dessin / idée à mettre dessus
              </label>

              <textarea
                id="keyDescription"
                placeholder="Décrivez le dessin ou le motif que vous souhaitez..."
              ></textarea>

              <div class="hint">
                Exemple : logo, animal, symbole, initiales...
              </div>

            </div>


            <!-- QUANTITÉ -->

            <div class="quantity">

              <button
                type="button"
                onclick="changeQuantity(-1)"
              >
                −
              </button>

              <span id="quantity">
                1
              </span>

              <button
                type="button"
                onclick="changeQuantity(1)"
              >
                +
              </button>

            </div>


            <!-- AJOUT PANIER -->

            <button
              type="button"
              class="btn"
              onclick="addToCart()"
            >
              🛒 Ajouter au panier
            </button>


            <div
              class="success"
              id="successMessage"
            >
              ✅ Porte-clé ajouté au panier !
            </div>


            <a
              href="panier.html"
              class="back"
            >
              Voir mon panier →
            </a>

          </div>

        </div>


        <!-- INFORMATIONS -->

        <div class="information">

          <h3>
            🔑 Votre porte-clé
          </h3>

          <ul>

            <li>
              Personnalisation selon votre demande
            </li>

            <li>
              Texte, prénom, nom ou entreprise
            </li>

            <li>
              Possibilité de demander un dessin ou un motif
            </li>

            <li>
              Impression 3D personnalisée
            </li>

            <li>
              Quantité modifiable directement sur la page
            </li>

          </ul>

        </div>

      </div>

    </section>

  </main>


  <!-- FOOTER -->

  <footer>

    <div class="container">

      © 2026 Aloïs Design

      <br>

      Impression 3D · Création de logos · Sculpture & gravure

      <br><br>

      <a
        href="mailto:aloisryckebuschvandaele@gmail.com"
        class="gold"
      >
        aloisryckebuschvandaele@gmail.com
      </a>

    </div>

  </footer>


  <!-- JAVASCRIPT -->

  <script>

    const CART_KEY =
      "aloisDesignCart";


    let quantity = 1;


    /* =========================
       QUANTITÉ
    ========================== */

    function changeQuantity(amount) {

      quantity += amount;

      if (quantity < 1) {
        quantity = 1;
      }

      if (quantity > 50) {
        quantity = 50;
      }

      document.getElementById(
        "quantity"
      ).textContent = quantity;

    }


    /* =========================
       AJOUT AU PANIER
    ========================== */

    function addToCart() {

      const text =
        document
          .getElementById("keyText")
          .value
          .trim();


      const color =
        document
          .getElementById("keyColor")
          .value;


      const description =
        document
          .getElementById("keyDescription")
          .value
          .trim();


      if (!text && !description) {

        alert(
          "Indiquez au moins un texte ou une description pour votre porte-clé."
        );

        return;

      }


      let cart = [];


      try {

        cart =
          JSON.parse(
            localStorage.getItem(
              CART_KEY
            )
          ) || [];

      } catch (error) {

        cart = [];

      }


      const newProduct = {

        id:
          "porte-cle-" +
          Date.now(),

        name:
          "Porte-clé personnalisé",

        price:
          6,

        quantity:
          quantity,

        customization: {

          text:
            text,

          color:
            color,

          description:
            description

        }

      };


      cart.push(
        newProduct
      );


      localStorage.setItem(
        CART_KEY,
        JSON.stringify(cart)
      );


      updateCartCount();


      const message =
        document.getElementById(
          "successMessage"
        );


      message.style.display =
        "block";


      setTimeout(
        () => {

          message.style.display =
            "none";

        },
        3000
      );

    }


    /* =========================
       COMPTEUR
    ========================== */

    function updateCartCount() {

      let cart = [];


      try {

        cart =
          JSON.parse(
            localStorage.getItem(
              CART_KEY
            )
          ) || [];

      } catch (error) {

        cart = [];

      }


      let count = 0;


      cart.forEach(
        item => {

          count +=
            Number(
              item.quantity
            ) || 0;

        }
      );


      document.getElementById(
        "cartCount"
      ).textContent =
        count;

    }


    updateCartCount();


    window.addEventListener(
      "storage",
      updateCartCount
    );

  </script>

</body>
</html>
