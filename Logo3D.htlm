<!DOCTYPE html>
<html lang="fr">
<head>

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Logo 3D | Aloïs Design</title>

  <meta
    name="description"
    content="Transformez votre logo en création 3D avec Aloïs Design."
  >

  <style>

    :root {
      --bg: #090909;
      --bg-light: #121212;
      --card: #171717;
      --gold: #d9a72b;
      --gold-light: #f3cc68;
      --white: #ffffff;
      --gray: #aaaaaa;
      --border: #292929;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: var(--bg);
      color: var(--white);
      line-height: 1.6;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button,
    input,
    select,
    textarea {
      font: inherit;
    }

    .container {
      width: min(1120px, 92%);
      margin: auto;
    }

    /* =========================
       HEADER
    ========================== */

    header {
      position: sticky;
      top: 0;
      z-index: 100;

      background: rgba(9, 9, 9, 0.96);
      backdrop-filter: blur(12px);

      border-bottom: 1px solid var(--border);
    }

    nav {
      min-height: 72px;

      display: flex;
      align-items: center;
      justify-content: space-between;

      gap: 15px;
    }

    .logo {
      font-size: 20px;
      font-weight: 900;

      letter-spacing: 2px;

      color: var(--gold);

      white-space: nowrap;
    }

    .logo span {
      color: white;
    }

    .nav-links {
      display: flex;
      align-items: center;

      gap: 20px;

      font-size: 14px;

      color: #ddd;
    }

    .nav-links a:hover {
      color: var(--gold-light);
    }

    /* =========================
       PANIER
    ========================== */

    .cart-link {
      position: relative;

      display: flex;
      align-items: center;
      justify-content: center;

      width: 42px;
      height: 42px;

      border: 1px solid #333;
      border-radius: 10px;

      background: #111;

      transition: 0.2s;
    }

    .cart-link:hover {
      border-color: var(--gold);
      transform: translateY(-2px);
    }

    .cart-icon {
      width: 25px;
      height: 25px;

      fill: none;

      stroke: var(--gold-light);

      stroke-width: 2;

      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .cart-count {
      position: absolute;

      top: -7px;
      right: -7px;

      min-width: 20px;
      height: 20px;

      padding: 2px 5px;

      border-radius: 50%;

      background: var(--gold);

      color: #111;

      font-size: 11px;

      font-weight: 900;

      text-align: center;
    }

    /* =========================
       BOUTONS
    ========================== */

    .btn {
      display: inline-block;

      padding: 13px 20px;

      border-radius: 10px;

      background: var(--gold);

      border: 1px solid var(--gold);

      color: #111;

      font-weight: 900;

      cursor: pointer;

      transition: 0.2s;
    }

    .btn:hover {
      background: var(--gold-light);
      border-color: var(--gold-light);
    }

    .btn-secondary {
      background: transparent;

      border-color: #444;

      color: white;
    }

    .btn-secondary:hover {
      border-color: var(--gold);

      color: var(--gold-light);

      background: transparent;
    }

    /* =========================
       HERO
    ========================== */

    .hero {
      padding: 110px 0 90px;

      background:
        radial-gradient(
          circle at 80% 20%,
          #30240c 0,
          transparent 35%
        );
    }

    .kicker {
      color: var(--gold-light);

      text-transform: uppercase;

      letter-spacing: 2px;

      font-size: 13px;

      font-weight: 800;

      margin-bottom: 15px;
    }

    .hero h1 {
      font-size: clamp(42px, 7vw, 75px);

      line-height: 1.02;

      max-width: 850px;

      margin-bottom: 22px;
    }

    .hero h1 span {
      color: var(--gold);
    }

    .hero p {
      max-width: 730px;

      color: var(--gray);

      font-size: 19px;
    }

    .hero-buttons {
      display: flex;

      flex-wrap: wrap;

      gap: 12px;

      margin-top: 30px;
    }

    /* =========================
       SECTIONS
    ========================== */

    section {
      padding: 80px 0;
    }

    .section-title {
      margin-bottom: 40px;
    }

    .section-title.center {
      text-align: center;
    }

    .section-title h2 {
      font-size: clamp(30px, 4vw, 44px);

      line-height: 1.1;

      margin-bottom: 10px;
    }

    .section-title p {
      color: var(--gray);
    }

    /* =========================
       PRODUITS
    ========================== */

    .products {
      display: grid;

      grid-template-columns: repeat(2, 1fr);

      gap: 20px;
    }

    .product {
      padding: 30px;

      border: 1px solid var(--border);

      background:
        linear-gradient(
          145deg,
          #181818,
          #101010
        );

      border-radius: 18px;

      transition: 0.2s;
    }

    .product:hover {
      transform: translateY(-5px);

      border-color: #4a3a15;
    }

    .product-icon {
      font-size: 45px;

      margin-bottom: 15px;
    }

    .product h3 {
      font-size: 25px;

      color: var(--gold-light);

      margin-bottom: 10px;
    }

    .product p {
      color: var(--gray);

      margin-bottom: 20px;
    }

    .price {
      color: white;

      font-size: 24px;

      font-weight: 900;

      margin-bottom: 20px;
    }

    .product ul {
      list-style: none;

      margin-bottom: 20px;
    }

    .product li {
      margin: 8px 0;

      color: #ddd;
    }

    .product li::before {
      content: "✓";

      color: var(--gold-light);

      margin-right: 9px;
    }

    /* =========================
       COMMENT ÇA MARCHE
    ========================== */

    .steps {
      display: grid;

      grid-template-columns: repeat(4, 1fr);

      gap: 15px;
    }

    .step {
      padding: 25px;

      border: 1px solid var(--border);

      background: var(--bg-light);

      border-radius: 16px;
    }

    .step-number {
      color: var(--gold);

      font-size: 30px;

      font-weight: 900;
    }

    .step h3 {
      margin: 5px 0 8px;
    }

    .step p {
      color: var(--gray);

      font-size: 14px;
    }

    /* =========================
       PAS DE LOGO
    ========================== */

    .no-logo {
      background:
        linear-gradient(
          145deg,
          #171207,
          #0e0e0e
        );

      border-top: 1px solid #392c10;

      border-bottom: 1px solid #392c10;
    }

    .no-logo-box {
      display: grid;

      grid-template-columns: 1fr 1fr;

      gap: 25px;
    }

    .info-box,
    .quote-box {
      padding: 30px;

      border: 1px solid var(--border);

      border-radius: 18px;

      background: #101010;
    }

    .info-box h3 {
      font-size: 28px;

      color: var(--gold-light);

      margin-bottom: 12px;
    }

    .info-box p {
      color: var(--gray);

      margin-bottom: 20px;
    }

    .info-box ul {
      list-style: none;
    }

    .info-box li {
      margin: 10px 0;

      color: #ddd;
    }

    .info-box li::before {
      content: "✓";

      color: var(--gold);

      margin-right: 10px;
    }

    /* =========================
       FORMULAIRE
    ========================== */

    form label {
      display: block;

      margin: 12px 0 6px;

      font-size: 14px;

      color: #ddd;
    }

    input,
    select,
    textarea {
      width: 100%;

      padding: 12px;

      border-radius: 9px;

      border: 1px solid #333;

      background: #080808;

      color: white;
    }

    input:focus,
    select:focus,
    textarea:focus {
      outline: 1px solid var(--gold);

      border-color: var(--gold);
    }

    textarea {
      min-height: 120px;

      resize: vertical;
    }

    /* =========================
       PANIER
    ========================== */

    .cart-box {
      text-align: center;

      padding: 40px;

      border: 1px solid var(--border);

      border-radius: 18px;

      background: var(--card);
    }

    .cart-box h2 {
      font-size: 30px;

      margin-bottom: 10px;
    }

    .cart-box p {
      color: var(--gray);

      margin-bottom: 25px;
    }

    /* =========================
       FOOTER
    ========================== */

    footer {
      border-top: 1px solid var(--border);

      padding: 35px 0;

      text-align: center;

      color: #888;

      font-size: 13px;
    }

    footer a {
      color: var(--gold-light);
    }

    /* =========================
       MOBILE
    ========================== */

    @media (max-width: 850px) {

      .nav-links {
        display: none;
      }

      .products,
      .steps,
      .no-logo-box {
        grid-template-columns: 1fr;
      }

      .hero {
        padding-top: 75px;
      }

    }

    @media (max-width: 500px) {

      .container {
        width: 90%;
      }

      .hero h1 {
        font-size: 42px;
      }

      .hero p {
        font-size: 17px;
      }

      .hero-buttons {
        flex-direction: column;
      }

      .hero-buttons .btn {
        width: 100%;
        text-align: center;
      }

      section {
        padding: 60px 0;
      }

    }

  </style>

</head>


<body>


<!-- =========================
     HEADER
========================== -->

<header>

  <div class="container">

    <nav>

      <a
        href="index.html"
        class="logo"
      >
        ALOÏS <span>DESIGN</span>
      </a>


      <div class="nav-links">

        <a href="index.html">
          Accueil
        </a>

        <a href="impression-3d.html">
          Impression 3D
        </a>

        <a href="logo3D.html">
          Logo 3D
        </a>

        <a href="porte-clé.html">
          Porte-clé
        </a>

        <a href="tampons.html">
          Tampons
        </a>

      </div>


      <a
        href="panier.html"
        class="cart-link"
        aria-label="Voir le panier"
      >

        <svg
          class="cart-icon"
          viewBox="0 0 24 24"
        >

          <circle
            cx="9"
            cy="20"
            r="1.5"
          ></circle>

          <circle
            cx="18"
            cy="20"
            r="1.5"
          ></circle>

          <path
            d="M3 4h2l2.2 11.2a2 2 0 0 0 2 1.6h7.8a2 2 0 0 0 1.9-1.4L21 8H6"
          ></path>

        </svg>


        <span
          class="cart-count"
          id="cartCount"
        >
          0
        </span>

      </a>

    </nav>

  </div>

</header>



<main>


<!-- =========================
     HERO
========================== -->

<section class="hero">

  <div class="container">

    <div class="kicker">
      IMPRESSION 3D
    </div>


    <h1>

      Votre logo en
      <span>3D.</span>

    </h1>


    <p>

      Transformez votre logo en une création
      3D personnalisée, idéale pour votre entreprise,
      votre bureau, votre boutique ou votre décoration.

    </p>


    <div class="hero-buttons">

      <a
        href="#produits"
        class="btn"
      >
        Voir les modèles
      </a>


      <!-- BON NOM DE FICHIER -->

      <a
        href="création%20de%20logo.html"
        class="btn btn-secondary"
      >
        🎨 Je n'ai pas de logo
      </a>


      <a
        href="panier.html"
        class="btn btn-secondary"
      >
        🛒 Mon panier
      </a>

    </div>

  </div>

</section>



<!-- =========================
     PRODUITS
========================== -->

<section id="produits">

  <div class="container">


    <div class="section-title center">

      <h2>
        Choisissez votre modèle
      </h2>

      <p>
        Plusieurs formats pour différents projets.
      </p>

    </div>


    <div class="products">


      <!-- PETIT -->

      <article class="product">

        <div class="product-icon">
          🔹
        </div>

        <h3>
          Logo 3D Petit
        </h3>

        <p>
          Un petit modèle pour bureau,
          décoration ou présentation.
        </p>

        <div class="price">
          25 €
        </div>

        <ul>

          <li>
            Format petit
          </li>

          <li>
            Logo personnalisé
          </li>

          <li>
            Impression 3D
          </li>

        </ul>

        <button
          class="btn"
          onclick="addToCart('Logo 3D Petit', 25)"
        >
          Ajouter au panier
        </button>

      </article>



      <!-- MOYEN -->

      <article class="product">

        <div class="product-icon">
          🔶
        </div>

        <h3>
          Logo 3D Moyen
        </h3>

        <p>
          Un format polyvalent pour
          mettre votre logo en valeur.
        </p>

        <div class="price">
          45 €
        </div>

        <ul>

          <li>
            Format moyen
          </li>

          <li>
            Logo personnalisé
          </li>

          <li>
            Impression 3D
          </li>

        </ul>

        <button
          class="btn"
          onclick="addToCart('Logo 3D Moyen', 45)"
        >
          Ajouter au panier
        </button>

      </article>



      <!-- GRAND -->

      <article class="product">

        <div class="product-icon">
          🟨
        </div>

        <h3>
          Logo 3D Grand
        </h3>

        <p>
          Un grand modèle pour décoration,
          entreprise ou présentation.
        </p>

        <div class="price">
          70 €
        </div>

        <ul>

          <li>
            Grand format
          </li>

          <li>
            Logo personnalisé
          </li>

          <li>
            Impression 3D
          </li>

        </ul>

        <button
          class="btn"
          onclick="addToCart('Logo 3D Grand', 70)"
        >
          Ajouter au panier
        </button>

      </article>



      <!-- PREMIUM -->

      <article class="product">

        <div class="product-icon">
          ⭐
        </div>

        <h3>
          Logo 3D Premium
        </h3>

        <p>
          Pour les projets complexes,
          très grands ou entièrement sur mesure.
        </p>

        <div class="price">
          À partir de 100 €
        </div>

        <ul>

          <li>
            Projet sur mesure
          </li>

          <li>
            Grande taille possible
          </li>

          <li>
            Devis personnalisé
          </li>

        </ul>


        <!-- BON NOM DE FICHIER -->

        <a
          href="création%20de%20logo.html"
          class="btn"
        >
          Demander un devis
        </a>

      </article>


    </div>

  </div>

</section>



<!-- =========================
     COMMENT ÇA MARCHE
========================== -->

<section>

  <div class="container">


    <div class="section-title center">

      <h2>
        Comment ça marche ?
      </h2>

      <p>
        De votre logo à votre création 3D.
      </p>

    </div>


    <div class="steps">


      <div class="step">

        <div class="step-number">
          01
        </div>

        <h3>
          Votre logo
        </h3>

        <p>
          Vous fournissez votre logo
          ou votre fichier.
        </p>

      </div>


      <div class="step">

        <div class="step-number">
          02
        </div>

        <h3>
          Préparation
        </h3>

        <p>
          Le fichier est adapté pour
          l'impression 3D.
        </p>

      </div>


      <div class="step">

        <div class="step-number">
          03
        </div>

        <h3>
          Impression
        </h3>

        <p>
          Votre logo est fabriqué
          en impression 3D.
        </p>

      </div>


      <div class="step">

        <div class="step-number">
          04
        </div>

        <h3>
          Livraison
        </h3>

        <p>
          Votre création est préparée
          puis expédiée.
        </p>

      </div>


    </div>

  </div>

</section>



<!-- =========================
     PAS DE LOGO
========================== -->

<section class="no-logo">

  <div class="container">


    <div class="no-logo-box">


      <div class="info-box">

        <h3>
          Vous n'avez pas encore de logo ?
        </h3>


        <p>

          Aucun problème. Vous pouvez d'abord
          demander la création de votre logo.
          Une fois votre logo créé, il pourra
          ensuite être adapté pour la 3D.

        </p>


        <ul>

          <li>
            Création d'un logo
          </li>

          <li>
            Modification d'un logo existant
          </li>

          <li>
            Préparation pour impression 3D
          </li>

          <li>
            Projet personnalisé
          </li>

        </ul>


        <br>


        <!-- BON NOM DE FICHIER -->

        <a
          href="création%20de%20logo.html"
          class="btn"
        >
          🎨 Créer mon logo
        </a>

      </div>



      <div class="quote-box">

        <h3>
          Votre projet est particulier ?
        </h3>


        <p style="color:var(--gray); margin:15px 0 20px;">

          Si vous avez besoin d'une taille,
          d'une forme ou d'une finition particulière,
          envoyez votre demande pour obtenir
          un devis.

        </p>


        <a
          href="création%20de%20logo.html"
          class="btn btn-secondary"
        >
          Demander un devis
        </a>

      </div>


    </div>

  </div>

</section>



<!-- =========================
     PANIER
========================== -->

<section>

  <div class="container">


    <div class="cart-box">

      <h2>
        🛒 Votre panier
      </h2>


      <p id="cartMessage">
        Votre panier est actuellement vide.
      </p>


      <a
        href="panier.html"
        class="btn"
      >
        Voir mon panier
      </a>

    </div>


  </div>

</section>


</main>



<!-- =========================
     FOOTER
========================== -->

<footer>

  <div class="container">

    <p>
      Aloïs Design
    </p>

    <p>
      Impression 3D · Création de logos ·
      Sculpture & gravure
    </p>

    <p style="margin-top:10px;">

      <a
        href="mailto:aloisryckebuschvandaele@gmail.com"
      >
        aloisryckebuschvandaele@gmail.com
      </a>

    </p>

    <p style="margin-top:10px;">
      © 2026 Aloïs Design
    </p>

  </div>

</footer>



<!-- =========================
     JAVASCRIPT PANIER
========================== -->

<script>

  const CART_KEY = "aloisDesignCart";


  function getCart() {

    try {

      return JSON.parse(
        localStorage.getItem(CART_KEY)
      ) || [];

    } catch (error) {

      return [];

    }

  }


  function saveCart(cart) {

    localStorage.setItem(
      CART_KEY,
      JSON.stringify(cart)
    );

  }


  function addToCart(name, price) {

    const cart = getCart();


    const existing = cart.find(
      item => item.name === name
    );


    if (existing) {

      existing.quantity =
        Number(existing.quantity || 0) + 1;

    } else {

      cart.push({

        name: name,

        price: Number(price),

        quantity: 1

      });

    }


    saveCart(cart);

    updateCart();


    alert(
      name + " a été ajouté au panier."
    );

  }


  function updateCart() {

    const cart = getCart();

    let count = 0;


    cart.forEach(function(item) {

      count +=
        Number(item.quantity) || 0;

    });


    document.getElementById(
      "cartCount"
    ).textContent = count;


    const message =
      document.getElementById(
        "cartMessage"
      );


    if (count === 0) {

      message.textContent =
        "Votre panier est actuellement vide.";

    } else if (count === 1) {

      message.textContent =
        "Vous avez 1 produit dans votre panier.";

    } else {

      message.textContent =
        "Vous avez " +
        count +
        " produits dans votre panier.";

    }

  }


  updateCart();


  window.addEventListener(
    "storage",
    updateCart
  );

</script>


</body>
</html>
