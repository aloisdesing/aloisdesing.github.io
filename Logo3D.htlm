<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Logo personnalisé | Alois Design</title>
  <meta name="description" content="Création et impression de logos personnalisés en 3D avec Alois Design.">

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, sans-serif;
      background: #f5f5f5;
      color: #222;
      line-height: 1.6;
    }

    header {
      background: #111;
      color: white;
      padding: 18px 20px;
      text-align: center;
    }

    header h1 {
      font-size: 30px;
      margin-bottom: 5px;
    }

    header p {
      color: #ccc;
    }

    .container {
      width: 90%;
      max-width: 1000px;
      margin: 40px auto;
    }

    .intro {
      text-align: center;
      margin-bottom: 35px;
    }

    .intro h2 {
      font-size: 32px;
      margin-bottom: 10px;
    }

    .intro p {
      color: #555;
    }

    .choice-container {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 25px;
    }

    .choice {
      background: white;
      border-radius: 18px;
      padding: 30px;
      box-shadow: 0 5px 20px rgba(0,0,0,0.08);
      text-align: center;
    }

    .choice h3 {
      font-size: 23px;
      margin-bottom: 12px;
    }

    .choice p {
      color: #666;
      margin-bottom: 22px;
    }

    .icon {
      font-size: 50px;
      margin-bottom: 15px;
    }

    .button {
      display: inline-block;
      padding: 13px 22px;
      border-radius: 10px;
      text-decoration: none;
      font-weight: bold;
      transition: 0.2s;
      border: none;
      cursor: pointer;
    }

    .button:hover {
      transform: translateY(-2px);
      opacity: 0.9;
    }

    .button-main {
      background: #111;
      color: white;
    }

    .button-secondary {
      background: #e9e9e9;
      color: #111;
    }

    .offers {
      margin-top: 45px;
    }

    .offers h2 {
      text-align: center;
      margin-bottom: 25px;
      font-size: 28px;
    }

    .products {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 20px;
    }

    .product {
      background: white;
      padding: 22px;
      border-radius: 15px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.07);
    }

    .product h3 {
      margin-bottom: 8px;
    }

    .price {
      font-size: 22px;
      font-weight: bold;
      margin: 12px 0;
    }

    .product p {
      color: #666;
      font-size: 14px;
      margin-bottom: 15px;
    }

    .back {
      text-align: center;
      margin: 40px 0;
    }

    footer {
      background: #111;
      color: #ccc;
      text-align: center;
      padding: 25px 15px;
      margin-top: 50px;
    }

    footer a {
      color: white;
      text-decoration: none;
    }

    @media (max-width: 600px) {
      .intro h2 {
        font-size: 27px;
      }

      header h1 {
        font-size: 25px;
      }
    }
  </style>
</head>

<body>

  <header>
    <h1>Alois Design</h1>
    <p>Impression 3D personnalisée</p>
  </header>

  <main class="container">

    <section class="intro">
      <h2>Logo personnalisé</h2>
      <p>
        Vous souhaitez transformer votre logo en objet 3D ?
        Choisissez l'option qui correspond à votre projet.
      </p>
    </section>

    <section class="choice-container">

      <!-- CLIENT QUI A DÉJÀ UN LOGO -->
      <div class="choice">
        <div class="icon">🎨</div>

        <h3>J'ai déjà mon logo</h3>

        <p>
          Vous avez déjà votre logo ?
          Envoyez-le et choisissez le type d'impression 3D
          que vous souhaitez.
        </p>

        <a href="#offres" class="button button-main">
          Voir les options
        </a>
      </div>

      <!-- CLIENT QUI N'A PAS DE LOGO -->
      <div class="choice">
        <div class="icon">✨</div>

        <h3>Je n'ai pas encore de logo</h3>

        <p>
          Vous avez une idée mais pas encore de logo ?
          Nous pouvons vous aider à créer un logo adapté à votre projet.
        </p>

        <a href="creation-logo.html" class="button button-main">
          Créer mon logo
        </a>
      </div>

    </section>


    <!-- OFFRES -->
    <section class="offers" id="offres">

      <h2>Nos options</h2>

      <div class="products">

        <div class="product">
          <h3>Logo simple</h3>

          <p>
            Impression de votre logo en 3D
            avec une finition simple.
          </p>

          <div class="price">
            À partir de 5 €
          </div>

          <a href="panier.html?produit=logo-simple"
             class="button button-main">
            Commander
          </a>
        </div>


        <div class="product">
          <h3>Logo personnalisé</h3>

          <p>
            Logo avec dimensions, couleurs
            ou finitions personnalisées.
          </p>

          <div class="price">
            À partir de 8 €
          </div>

          <a href="panier.html?produit=logo-personnalise"
             class="button button-main">
            Commander
          </a>
        </div>


        <div class="product">
          <h3>Logo grand format</h3>

          <p>
            Pour une enseigne, une décoration
            ou un projet nécessitant un format plus important.
          </p>

          <div class="price">
            Sur devis
          </div>

          <a href="creation-logo.html"
             class="button button-secondary">
            Demander un devis
          </a>
        </div>

      </div>

    </section>


    <div class="back">
      <a href="impression.html" class="button button-secondary">
        ← Retour à l'impression 3D
      </a>
    </div>

  </main>


  <footer>
    <p>Alois Design</p>

    <p>
      <a href="mailto:aloisryckebuschvandaele@gmail.com">
        aloisryckebuschvandaele@gmail.com
      </a>
    </p>

    <p>© 2026 Alois Design - Tous droits réservés</p>
  </footer>

</body>
</html>
