<!DOCTYPE html>
<html lang="fr">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>Logo 3D | Aloïs Design</title>

  <meta
    name="description"
    content="Transformez votre logo en création 3D personnalisée avec Aloïs Design."
  >

  <style>

    :root {
      --bg: #090909;
      --bg-light: #121212;
      --card: #171717;
      --gold: #d9a72b;
      --gold-light: #f3cc68;
      --white: #ffffff;
      --gray: #aaaaaa;
      --border: #292929;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: var(--bg);
      color: var(--white);
      line-height: 1.6;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .container {
      width: min(1120px, 92%);
      margin: auto;
    }

    /* =========================
       HEADER
    ========================== */

    header {
      position: sticky;
      top: 0;
      z-index: 100;

      background: rgba(9, 9, 9, 0.96);

      backdrop-filter: blur(12px);

      border-bottom: 1px solid var(--border);
    }

    nav {
      min-height: 72px;

      display: flex;

      align-items: center;

      justify-content: space-between;

      gap: 15px;
    }

    .logo {
      font-size: 20px;

      font-weight: 900;

      letter-spacing: 2px;

      color: var(--gold);

      white-space: nowrap;
    }

    .logo span {
      color: white;
    }

    .nav-links {
      display: flex;

      align-items: center;

      gap: 18px;

      font-size: 14px;

      color: #ddd;
    }

    .nav-links a:hover {
      color: var(--gold-light);
    }

    /* =========================
       PANIER
    ========================== */

    .cart-link {
      position: relative;

      display: flex;

      align-items: center;

      justify-content: center;

      width: 44px;

      height: 44px;

      border: 1px solid #333;

      border-radius: 10px;

      background: #111;

      transition: 0.2s;
    }

    .cart-link:hover {
      border-color: var(--gold);

      transform: translateY(-2px);
    }

    .cart-icon {
      width: 25px;

      height: 25px;

      fill: none;

      stroke: var(--gold-light);

      stroke-width: 2;

      stroke-linecap: round;

      stroke-linejoin: round;
    }

    .cart-count {
      position: absolute;

      top: -7px;

      right: -7px;

      min-width: 20px;

      height: 20px;

      padding: 2px 5px;

      border-radius: 50%;

      background: var(--gold);

      color: #111;

      font-size: 11px;

      font-weight: 900;

      text-align: center;
    }

    /* =========================
       BOUTONS
    ========================== */

    .btn {
      display: inline-block;

      padding: 13px 20px;

      border-radius: 10px;

      background: var(--gold);

      border: 1px solid var(--gold);

      color: #111;

      font-weight: 900;

      cursor: pointer;

      transition: 0.2s;
    }

    .btn:hover {
      background: var(--gold-light);

      border-color: var(--gold-light);
    }

    .btn-secondary {
      background: transparent;

      border-color: #444;

      color: white;
    }

    .btn-secondary:hover {
      border-color: var(--gold);

      color: var(--gold-light);

      background: transparent;
    }

    /* =========================
       HERO
    ========================== */

    .hero {
      padding: 100px 0 80px;

      background:
        radial-gradient(
          circle at 80% 20%,
          #30240c 0,
          transparent 35%
        );
    }

    .kicker {
      color: var(--gold-light);

      text-transform: uppercase;

      letter-spacing: 2px;

      font-size: 13px;

      font-weight: 800;

      margin-bottom: 15px;
    }

    .hero h1 {
      font-size: clamp(42px, 7vw, 76px);

      line-height: 1.02;

      max-width: 850px;

      margin-bottom: 22px;
    }

    .hero h1 span {
      color: var(--gold);
    }

    .hero p {
      max-width: 760px;

      color: var(--gray);

      font-size: 19px;
    }

    .hero-buttons {
      display: flex;

      flex-wrap: wrap;

      gap: 12px;

      margin-top: 30px;
    }

    /* =========================
       SECTIONS
    ========================== */

    section {
      padding: 75px 0;
    }

    .section-title {
      margin-bottom: 35px;
    }

    .section-title.center {
      text-align: center;
    }

    .section-title h2 {
      font-size: clamp(30px, 4vw, 44px);

      line-height: 1.1;

      margin-bottom: 10px;
    }

    .section-title p {
      color: var(--gray);
    }

    /* =========================
       PRODUITS
    ========================== */

    .products {
      display: grid;

      grid-template-columns:
        repeat(4, 1fr);

      gap: 18px;
    }

    .product {
      padding: 27px;

      border: 1px solid var(--border);

      background:
        linear-gradient(
          145deg,
          #181818,
          #101010
        );

      border-radius: 18px;

      transition: 0.2s;
    }

    .product:hover {
      transform: translateY(-5px);

      border-color: #4a3a15;
    }

    .product-icon {
      font-size: 42px;

      margin-bottom: 14px;
    }

    .product h3 {
      font-size: 23px;

      color: var(--gold-light);

      margin-bottom: 9px;
    }

    .product p {
      color: var(--gray);

      min-height: 90px;
    }

    .price {
      margin: 17px 0;

      font-size: 18px;

      font-weight: 900;

      color: var(--gold-light);
    }

    /* =========================
       FORMULAIRE
    ========================== */

    .form-grid {
      display: grid;

      grid-template-columns:
        1fr 1fr;

      gap: 20px;
    }

    .form-box {
      padding: 30px;

      border: 1px solid var(--border);

      border-radius: 18px;

      background:
        linear-gradient(
          145deg,
          #181818,
          #101010
        );
    }

    .form-box h3 {
      font-size: 25px;

      margin-bottom: 10px;
    }

    .form-box > p {
      color: var(--gray);

      margin-bottom: 20px;
    }

    form label {
      display: block;

      margin: 13px 0 6px;

      font-size: 14px;

      color: #ddd;
    }

    input,
    select,
    textarea {
      width: 100%;

      padding: 12px;

      border-radius: 9px;

      border: 1px solid #333;

      background: #080808;

      color: white;

      font: inherit;
    }

    input:focus,
    select:focus,
    textarea:focus {
      outline: 1px solid var(--gold);

      border-color: var(--gold);
    }

    textarea {
      min-height: 130px;

      resize: vertical;
    }

    /* =========================
       INFORMATIONS
    ========================== */

    .info-grid {
      display: grid;

      grid-template-columns:
        repeat(3, 1fr);

      gap: 20px;
    }

    .info-card {
      padding: 28px;

      border: 1px solid var(--border);

      border-radius: 18px;

      background: var(--bg-light);
    }

    .info-card h3 {
      margin-bottom: 10px;

      color: var(--gold-light);
    }

    .info-card p {
      color: var(--gray);
    }

    /* =========================
       NOTICE
    ========================== */

    .notice {
      margin-top: 20px;

      padding: 17px 18px;

      border-radius: 12px;

      border: 1px solid #4a3a15;

      background: #171207;

      color: #ddd;
    }

    /* =========================
       FOOTER
    ========================== */

    footer {
      border-top: 1px solid var(--border);

      padding: 35px 0;

      text-align: center;

      color: #888;

      font-size: 13px;
    }

    .gold {
      color: var(--gold-light);
    }

    /* =========================
       MOBILE
    ========================== */

    @media (max-width: 1000px) {

      .products {
        grid-template-columns:
          repeat(2, 1fr);
      }

    }

    @media (max-width: 850px) {

      .nav-links {
        display: none;
      }

      .form-grid,
      .info-grid {
        grid-template-columns: 1fr;
      }

      .hero {
        padding-top: 70px;
      }

      .hero h1 {
        font-size: 48px;
      }

    }

    @media (max-width: 600px) {

      .container {
        width: 90%;
      }

      .products {
        grid-template-columns: 1fr;
      }

      .hero h1 {
        font-size: 42px;
      }

      .hero p {
        font-size: 17px;
      }

      .hero-buttons {
        flex-direction: column;
      }

      .hero-buttons .btn {
        width: 100%;

        text-align: center;
      }

      .btn {
        width: 100%;

        text-align: center;
      }

      section {
        padding: 55px 0;
      }

    }

  </style>

</head>


<body>


  <!-- =========================
       HEADER
  ========================== -->

  <header>

    <div class="container">

      <nav>

        <a
          href="index.html"
          class="logo"
        >
          ALOÏS <span>DESIGN</span>
        </a>


        <div class="nav-links">

          <a href="index.html">
            Accueil
          </a>

          <a href="impression-3d.html">
            Impression 3D
          </a>

          <a href="creation-logo.html">
            Création de logo
          </a>

          <a href="tampons.html">
            Tampons
          </a>

        </div>


        <a
          href="panier.html"
          class="cart-link"
          aria-label="Voir le panier"
        >

          <svg
            class="cart-icon"
            viewBox="0 0 24 24"
          >

            <circle
              cx="9"
              cy="20"
              r="1.5"
            ></circle>

            <circle
              cx="18"
              cy="20"
              r="1.5"
            ></circle>

            <path
              d="M3 4h2l2.2 11.2a2 2 0 0 0 2 1.6h7.8a2 2 0 0 0 1.9-1.4L21 8H6"
            ></path>

          </svg>

          <span
            class="cart-count"
            id="cartCount"
          >
            0
          </span>

        </a>

      </nav>

    </div>

  </header>


  <main>


    <!-- =========================
         HERO
    ========================== -->

    <section class="hero">

      <div class="container">

        <div class="kicker">
          Impression 3D personnalisée
        </div>

        <h1>
          Votre logo en
          <span>3D.</span>
        </h1>

        <p>
          Transformez votre logo en une véritable création
          en relief. Choisissez la taille qui correspond
          à votre projet et ajoutez-la directement au panier.
        </p>

        <div class="hero-buttons">

          <a
            href="#produits"
            class="btn"
          >
            Choisir une taille
          </a>

          <a
            href="creation-logo.html"
            class="btn btn-secondary"
          >
            Je n'ai pas encore de logo
          </a>

        </div>

      </div>

    </section>


    <!-- =========================
         PRODUITS
    ========================== -->

    <section id="produits">

      <div class="container">

        <div class="section-title center">

          <h2>
            🎨 Choisissez votre format
          </h2>

          <p>
            Plusieurs formats pour transformer votre logo
            en création 3D.
          </p>

        </div>


        <div class="products">


          <!-- PETIT -->

          <article class="product">

            <div class="product-icon">
              🟡
            </div>

            <h3>
              Petit
            </h3>

            <p>
              Petit logo 3D pour une décoration,
              un bureau ou un petit objet personnalisé.
            </p>

            <div class="price">
              25 €
            </div>

            <button
              class="btn"
              onclick="addLogo(
                'Logo 3D - Petit',
                25
              )"
            >
              Ajouter au panier
            </button>

          </article>


          <!-- MOYEN -->

          <article class="product">

            <div class="product-icon">
              🟠
            </div>

            <h3>
              Moyen
            </h3>

            <p>
              Un format polyvalent pour mettre
              votre logo davantage en valeur.
            </p>

            <div class="price">
              45 €
            </div>

            <button
              class="btn"
              onclick="addLogo(
                'Logo 3D - Moyen',
                45
              )"
            >
              Ajouter au panier
            </button>

          </article>


          <!-- GRAND -->

          <article class="product">

            <div class="product-icon">
              🔶
            </div>

            <h3>
              Grand
            </h3>

            <p>
              Un grand format pour une décoration
              ou une présentation plus imposante.
            </p>

            <div class="price">
              70 €
            </div>

            <button
              class="btn"
              onclick="addLogo(
                'Logo 3D - Grand',
                70
              )"
            >
              Ajouter au panier
            </button>

          </article>


          <!-- PREMIUM -->

          <article class="product">

            <div class="product-icon">
              👑
            </div>

            <h3>
              Premium
            </h3>

            <p>
              Grande création personnalisée,
              éventuellement réalisée en plusieurs pièces.
            </p>

            <div class="price">
              À partir de 100 €
            </div>

            <a
              href="creation-logo.html"
              class="btn"
            >
              Demander un devis
            </a>

          </article>

        </div>

      </div>

    </section>


    <!-- =========================
         PERSONNALISATION
    ========================== -->

    <section>

      <div class="container">

        <div class="form-grid">


          <!-- INFORMATIONS -->

          <div class="form-box">

            <h3>
              🖨️ Comment sera réalisé votre logo ?
            </h3>

            <p>
              Votre logo est adapté pour être imprimé
              en 3D avant la fabrication.
            </p>


            <div class="notice">

              💡 Si vous avez déjà un logo,
              vous pourrez fournir les informations
              nécessaires concernant votre fichier
              lors de votre demande.

            </div>


            <div class="info-grid">

              <div class="info-card">

                <h3>
                  01
                </h3>

                <p>
                  Vous choisissez le format
                  de votre logo.
                </p>

              </div>


              <div class="info-card">

                <h3>
                  02
                </h3>

                <p>
                  Vous fournissez votre logo
                  ou vos indications.
                </p>

              </div>


              <div class="info-card">

                <h3>
                  03
                </h3>

                <p>
                  Le fichier est préparé
                  pour l'impression.
                </p>

              </div>

            </div>

          </div>


          <!-- FORMULAIRE -->

          <div class="form-box">

            <h3>
              📋 Vous avez déjà votre logo ?
            </h3>

            <p>
              Indiquez les informations de votre projet.
            </p>


            <form
              action="mailto:aloisryckebuschvandaele@gmail.com"
              method="post"
              enctype="text/plain"
            >

              <label for="nom">
                Nom / prénom
              </label>

              <input
                type="text"
                id="nom"
                name="Nom / prénom"
                placeholder="Votre nom"
                required
              >


              <label for="email">
                Email
              </label>

              <input
                type="email"
                id="email"
                name="Email"
                placeholder="Votre adresse e-mail"
                required
              >


              <label for="taille">
                Format souhaité
              </label>

              <select
                id="taille"
                name="Format"
              >

                <option value="Petit">
                  Petit — 25 €
                </option>

                <option value="Moyen">
                  Moyen — 45 €
                </option>

                <option value="Grand">
                  Grand — 70 €
                </option>

                <option value="Premium">
                  Premium — à partir de 100 €
                </option>

              </select>


              <label for="couleur">
                Couleur souhaitée
              </label>

              <input
                type="text"
                id="couleur"
                name="Couleur"
                placeholder="Ex. noir, blanc, doré..."
              >


              <label for="description">
                Informations sur votre logo
              </label>

              <textarea
                id="description"
                name="Description"
                placeholder="Décrivez votre logo et votre projet..."
                required
              ></textarea>


              <button
                type="submit"
                class="btn"
                style="
                  width:100%;
                  margin-top:20px;
                  border:none;
                "
              >
                📩 Envoyer ma demande
              </button>

            </form>

          </div>

        </div>

      </div>

    </section>


    <!-- =========================
         PAS DE LOGO
    ========================== -->

    <section>

      <div class="container">

        <div
          class="form-box"
          style="text-align:center;"
        >

          <h2>
            Vous n'avez pas encore de logo ?
          </h2>

          <p
            style="
              max-width:700px;
              margin:12px auto 25px;
              color:#aaa;
            "
          >
            Aucun problème. Nous pouvons d'abord
            créer votre logo, puis l'adapter pour
            une impression 3D.
          </p>

          <a
            href="creation-logo.html"
            class="btn"
          >
            🎨 Créer mon logo
          </a>

        </div>

      </div>

    </section>


    <!-- =========================
         PANIER
    ========================== -->

    <section>

      <div class="container">

        <div
          class="form-box"
          style="text-align:center;"
        >

          <h2>
            🛒 Votre panier
          </h2>

          <p
            style="
              color:#aaa;
              margin:10px 0 22px;
            "
          >
            Retrouvez vos créations sélectionnées.
          </p>

          <a
            href="panier.html"
            class="btn"
          >
            Voir mon panier
          </a>

        </div>

      </div>

    </section>


  </main>


  <!-- =========================
       FOOTER
  ========================== -->

  <footer>

    <div class="container">

      © 2026 Aloïs Design

      <br>

      Impression 3D · Création de logos · Sculpture & gravure

      <br><br>

      <a
        href="mailto:aloisryckebuschvandaele@gmail.com"
        class="gold"
      >
        aloisryckebuschvandaele@gmail.com
      </a>

    </div>

  </footer>


  <!-- =========================
       PANIER
  ========================== -->

  <script>

    const CART_KEY =
      "aloisDesignCart";


    function getCart() {

      try {

        return JSON.parse(
          localStorage.getItem(CART_KEY)
        ) || [];

      } catch (error) {

        return [];

      }

    }


    function saveCart(cart) {

      localStorage.setItem(
        CART_KEY,
        JSON.stringify(cart)
      );

      updateCartCount();

    }


    function updateCartCount() {

      const cart =
        getCart();

      let count = 0;


      cart.forEach(item => {

        count +=
          Number(item.quantity) || 0;

      });


      const counter =
        document.getElementById(
          "cartCount"
        );


      if (counter) {

        counter.textContent =
          count;

      }

    }


    function addLogo(
      name,
      price
    ) {

      const cart =
        getCart();


      const key =
        name;


      const existing =
        cart.find(
          item => item.key === key
        );


      if (existing) {

        existing.quantity =
          Number(existing.quantity || 0) + 1;

      } else {

        cart.push({

          key: key,

          name: name,

          price: Number(price),

          quantity: 1

        });

      }


      saveCart(cart);


      alert(
        name +
        " a été ajouté au panier."
      );

    }


    updateCartCount();


    window.addEventListener(
      "storage",
      updateCartCount
    );

  </script>


</body>

</html>
