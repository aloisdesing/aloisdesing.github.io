<!DOCTYPE html>
<html lang="fr">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>Panier | Aloïs Design</title>

  <meta
    name="description"
    content="Votre panier Aloïs Design."
  >

  <style>

    :root {
      --bg: #090909;
      --bg-light: #121212;
      --card: #171717;
      --gold: #d9a72b;
      --gold-light: #f3cc68;
      --white: #ffffff;
      --gray: #aaaaaa;
      --border: #292929;
      --danger: #d9534f;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: var(--bg);
      color: var(--white);
      line-height: 1.6;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button {
      font-family: inherit;
    }

    .container {
      width: min(1120px, 92%);
      margin: auto;
    }

    /* =========================
       HEADER
    ========================== */

    header {
      position: sticky;
      top: 0;
      z-index: 100;

      background: rgba(9, 9, 9, 0.96);

      backdrop-filter: blur(12px);

      border-bottom: 1px solid var(--border);
    }

    nav {
      min-height: 72px;

      display: flex;

      align-items: center;

      justify-content: space-between;

      gap: 15px;
    }

    .logo {
      font-size: 20px;

      font-weight: 900;

      letter-spacing: 2px;

      color: var(--gold);

      white-space: nowrap;
    }

    .logo span {
      color: white;
    }

    .nav-links {
      display: flex;

      align-items: center;

      gap: 18px;

      font-size: 14px;

      color: #ddd;
    }

    .nav-links a:hover {
      color: var(--gold-light);
    }

    /* =========================
       PANIER HEADER
    ========================== */

    .cart-link {
      position: relative;

      display: flex;

      align-items: center;

      justify-content: center;

      width: 44px;

      height: 44px;

      border: 1px solid var(--gold);

      border-radius: 10px;

      background: #111;
    }

    .cart-icon {
      width: 25px;

      height: 25px;

      fill: none;

      stroke: var(--gold-light);

      stroke-width: 2;

      stroke-linecap: round;

      stroke-linejoin: round;
    }

    .cart-count {
      position: absolute;

      top: -7px;

      right: -7px;

      min-width: 20px;

      height: 20px;

      padding: 2px 5px;

      border-radius: 50%;

      background: var(--gold);

      color: #111;

      font-size: 11px;

      font-weight: 900;

      text-align: center;
    }

    /* =========================
       HERO
    ========================== */

    .hero {
      padding: 85px 0 55px;

      background:
        radial-gradient(
          circle at 80% 20%,
          #30240c 0,
          transparent 35%
        );
    }

    .kicker {
      color: var(--gold-light);

      text-transform: uppercase;

      letter-spacing: 2px;

      font-size: 13px;

      font-weight: 800;

      margin-bottom: 12px;
    }

    .hero h1 {
      font-size: clamp(40px, 7vw, 70px);

      line-height: 1.05;

      margin-bottom: 15px;
    }

    .hero h1 span {
      color: var(--gold);
    }

    .hero p {
      color: var(--gray);

      font-size: 18px;

      max-width: 700px;
    }

    /* =========================
       PANIER
    ========================== */

    .cart-section {
      padding: 40px 0 90px;
    }

    .cart-layout {
      display: grid;

      grid-template-columns: 1fr 350px;

      gap: 25px;

      align-items: start;
    }

    .cart-box,
    .summary-box {
      border: 1px solid var(--border);

      border-radius: 18px;

      background:
        linear-gradient(
          145deg,
          #181818,
          #101010
        );
    }

    .cart-box {
      padding: 25px;
    }

    .summary-box {
      padding: 25px;

      position: sticky;

      top: 95px;
    }

    .box-title {
      font-size: 25px;

      margin-bottom: 20px;
    }

    /* =========================
       PRODUITS
    ========================== */

    .cart-item {
      display: grid;

      grid-template-columns: 70px 1fr auto;

      gap: 18px;

      align-items: center;

      padding: 20px 0;

      border-bottom: 1px solid var(--border);
    }

    .cart-item:last-child {
      border-bottom: none;
    }

    .item-icon {
      width: 70px;

      height: 70px;

      display: flex;

      align-items: center;

      justify-content: center;

      border-radius: 14px;

      background: #0b0b0b;

      border: 1px solid #333;

      font-size: 30px;
    }

    .item-name {
      font-size: 18px;

      font-weight: 800;

      margin-bottom: 5px;
    }

    .item-price {
      color: var(--gold-light);

      font-size: 14px;
    }

    .item-total {
      color: var(--gold-light);

      font-size: 18px;

      font-weight: 900;

      margin-bottom: 8px;

      text-align: right;
    }

    /* =========================
       QUANTITÉ
    ========================== */

    .quantity {
      display: flex;

      align-items: center;

      gap: 7px;

      margin-top: 10px;
    }

    .quantity button {
      width: 30px;

      height: 30px;

      border-radius: 7px;

      border: 1px solid #444;

      background: #0b0b0b;

      color: white;

      cursor: pointer;

      font-size: 17px;
    }

    .quantity button:hover {
      border-color: var(--gold);

      color: var(--gold-light);
    }

    .quantity span {
      min-width: 30px;

      text-align: center;

      font-weight: 800;
    }

    /* =========================
       SUPPRIMER
    ========================== */

    .remove {
      background: transparent;

      border: none;

      color: #999;

      cursor: pointer;

      font-size: 13px;

      padding: 0;
    }

    .remove:hover {
      color: #ff7777;
    }

    /* =========================
       TOTAL
    ========================== */

    .summary-line {
      display: flex;

      justify-content: space-between;

      gap: 15px;

      padding: 12px 0;

      color: #ccc;
    }

    .summary-line.total {
      margin-top: 10px;

      padding-top: 20px;

      border-top: 1px solid var(--border);

      color: white;

      font-size: 22px;

      font-weight: 900;
    }

    .summary-total {
      color: var(--gold-light);
    }

    /* =========================
       BOUTONS
    ========================== */

    .btn {
      display: inline-block;

      width: 100%;

      padding: 13px 20px;

      border-radius: 10px;

      background: var(--gold);

      border: 1px solid var(--gold);

      color: #111;

      font-weight: 900;

      cursor: pointer;

      text-align: center;

      transition: 0.2s;
    }

    .btn:hover {
      background: var(--gold-light);

      border-color: var(--gold-light);
    }

    .btn-secondary {
      background: transparent;

      border-color: #444;

      color: white;

      margin-top: 10px;
    }

    .btn-secondary:hover {
      background: transparent;

      border-color: var(--gold);

      color: var(--gold-light);
    }

    .btn-danger {
      background: transparent;

      border-color: #533;

      color: #ff8a8a;

      margin-top: 10px;
    }

    .btn-danger:hover {
      background: #210d0d;

      border-color: #a44;

      color: #ffaaaa;
    }

    /* =========================
       PANIER VIDE
    ========================== */

    .empty-cart {
      text-align: center;

      padding: 65px 25px;
    }

    .empty-icon {
      font-size: 65px;

      margin-bottom: 15px;
    }

    .empty-cart h2 {
      font-size: 28px;

      margin-bottom: 10px;
    }

    .empty-cart p {
      color: var(--gray);

      margin-bottom: 25px;
    }

    .empty-cart .btn {
      width: auto;

      min-width: 220px;
    }

    /* =========================
       INFO
    ========================== */

    .info {
      margin-top: 20px;

      padding: 15px;

      border: 1px solid #3d3012;

      background: #171207;

      border-radius: 10px;

      color: #bbb;

      font-size: 13px;
    }

    /* =========================
       FOOTER
    ========================== */

    footer {
      border-top: 1px solid var(--border);

      padding: 35px 0;

      text-align: center;

      color: #888;

      font-size: 13px;
    }

    .gold {
      color: var(--gold-light);
    }

    /* =========================
       MOBILE
    ========================== */

    @media (max-width: 850px) {

      .nav-links {
        display: none;
      }

      .cart-layout {
        grid-template-columns: 1fr;
      }

      .summary-box {
        position: static;
      }

    }

    @media (max-width: 600px) {

      .container {
        width: 90%;
      }

      .hero {
        padding-top: 65px;
      }

      .cart-box {
        padding: 17px;
      }

      .cart-item {
        grid-template-columns: 55px 1fr;

        gap: 12px;
      }

      .item-icon {
        width: 55px;

        height: 55px;

        font-size: 24px;
      }

      .item-actions {
        grid-column: 2;
      }

      .item-total {
        text-align: left;
      }

    }

  </style>

</head>


<body>


  <!-- =========================
       HEADER
  ========================== -->

  <header>

    <div class="container">

      <nav>

        <a
          href="index.html"
          class="logo"
        >
          ALOÏS <span>DESIGN</span>
        </a>


        <div class="nav-links">

          <a href="index.html">
            Accueil
          </a>

          <a href="impression-3d.html">
            Impression 3D
          </a>

          <a href="Logo3D.html">
            Logo 3D
          </a>

          <a href="porte-clé.html">
            Porte-clé
          </a>

          <a href="tampons.html">
            Tampons
          </a>

          <a href="creation-logo.html">
            Création de logo
          </a>

        </div>


        <a
          href="panier.html"
          class="cart-link"
          aria-label="Panier"
        >

          <svg
            class="cart-icon"
            viewBox="0 0 24 24"
          >

            <circle
              cx="9"
              cy="20"
              r="1.5"
            ></circle>

            <circle
              cx="18"
              cy="20"
              r="1.5"
            ></circle>

            <path
              d="M3 4h2l2.2 11.2a2 2 0 0 0 2 1.6h7.8a2 2 0 0 0 1.9-1.4L21 8H6"
            ></path>

          </svg>

          <span
            class="cart-count"
            id="cartCount"
          >
            0
          </span>

        </a>

      </nav>

    </div>

  </header>


  <main>


    <!-- =========================
         TITRE
    ========================== -->

    <section class="hero">

      <div class="container">

        <div class="kicker">
          Aloïs Design
        </div>

        <h1>
          Votre <span>panier.</span>
        </h1>

        <p>
          Retrouvez ici toutes les créations que vous
          avez sélectionnées avant de passer votre commande.
        </p>

      </div>

    </section>


    <!-- =========================
         PANIER
    ========================== -->

    <section class="cart-section">

      <div class="container">


        <!-- PANIER REMPLI -->

        <div
          id="cartContent"
          class="cart-layout"
        >


          <!-- PRODUITS -->

          <div class="cart-box">

            <h2 class="box-title">
              🛒 Mes produits
            </h2>

            <div id="cartItems"></div>

          </div>


          <!-- RÉCAPITULATIF -->

          <aside class="summary-box">

            <h2 class="box-title">
              Récapitulatif
            </h2>


            <div class="summary-line">

              <span>
                Produits
              </span>

              <span id="productsCount">
                0
              </span>

            </div>


            <div class="summary-line">

              <span>
                Sous-total
              </span>

              <span id="subtotal">
                0,00 €
              </span>

            </div>


            <div class="summary-line">

              <span>
                Livraison
              </span>

              <span>
                À définir
              </span>

            </div>


            <div class="summary-line total">

              <span>
                Total
              </span>

              <span
                class="summary-total"
                id="total"
              >
                0,00 €
              </span>

            </div>


            <div class="info">

              💡 Le montant de la livraison pourra être
              confirmé selon la commande et l'adresse
              d'expédition.

            </div>


            <button
              class="btn"
              style="margin-top:20px;"
              onclick="sendOrder()"
            >
              📩 Passer la commande
            </button>


            <a
              href="impression-3d.html"
              class="btn btn-secondary"
            >
              Continuer mes achats
            </a>


            <button
              class="btn btn-danger"
              onclick="clearCart()"
            >
              Vider le panier
            </button>

          </aside>

        </div>


        <!-- =========================
             PANIER VIDE
        ========================== -->

        <div
          id="emptyCart"
          class="cart-box empty-cart"
          style="display:none;"
        >

          <div class="empty-icon">
            🛒
          </div>

          <h2>
            Votre panier est vide
          </h2>

          <p>
            Vous n'avez encore ajouté aucun produit.
          </p>

          <a
            href="impression-3d.html"
            class="btn"
          >
            Découvrir les produits
          </a>

        </div>

      </div>

    </section>


  </main>


  <!-- =========================
       FOOTER
  ========================== -->

  <footer>

    <div class="container">

      © 2026 Aloïs Design

      <br>

      Impression 3D · Création de logos · Sculpture & gravure

      <br><br>

      <a
        href="mailto:aloisryckebuschvandaele@gmail.com"
        class="gold"
      >
        aloisryckebuschvandaele@gmail.com
      </a>

    </div>

  </footer>


  <!-- =========================
       JAVASCRIPT PANIER
  ========================== -->

  <script>

    const CART_KEY =
      "aloisDesignCart";


    /* =========================
       RÉCUPÉRER LE PANIER
    ========================== */

    function getCart() {

      try {

        return JSON.parse(
          localStorage.getItem(CART_KEY)
        ) || [];

      } catch (error) {

        return [];

      }

    }


    /* =========================
       SAUVEGARDER
    ========================== */

    function saveCart(cart) {

      localStorage.setItem(
        CART_KEY,
        JSON.stringify(cart)
      );

    }


    /* =========================
       FORMAT PRIX
    ========================== */

    function formatPrice(price) {

      return Number(price).toLocaleString(
        "fr-FR",
        {
          minimumFractionDigits: 2,
          maximumFractionDigits: 2
        }
      ) + " €";

    }


    /* =========================
       ICÔNE PRODUIT
    ========================== */

    function getIcon(name) {

      const text =
        name.toLowerCase();

      if (
        text.includes("logo")
      ) {
        return "🎨";
      }

      if (
        text.includes("porte")
      ) {
        return "🔑";
      }

      if (
        text.includes("tampon")
      ) {
        return "🔖";
      }

      if (
        text.includes("impression")
      ) {
        return "🖨️";
      }

      return "📦";

    }


    /* =========================
       AFFICHER LE PANIER
    ========================== */

    function renderCart() {

      const cart =
        getCart();


      const cartContent =
        document.getElementById(
          "cartContent"
        );

      const emptyCart =
        document.getElementById(
          "emptyCart"
        );

      const cartItems =
        document.getElementById(
          "cartItems"
        );


      let totalQuantity = 0;

      let totalPrice = 0;


      cart.forEach(item => {

        totalQuantity +=
          Number(item.quantity) || 0;

        totalPrice +=
          (Number(item.price) || 0) *
          (Number(item.quantity) || 0);

      });


      /* PANIER VIDE */

      if (cart.length === 0) {

        cartContent.style.display =
          "none";

        emptyCart.style.display =
          "block";

        updateHeaderCount();

        return;

      }


      /* PANIER REMPLI */

      cartContent.style.display =
        "grid";

      emptyCart.style.display =
        "none";


      cartItems.innerHTML = "";


      cart.forEach((item, index) => {

        const quantity =
          Number(item.quantity) || 1;

        const price =
          Number(item.price) || 0;

        const itemTotal =
          price * quantity;


        const element =
          document.createElement(
            "div"
          );


        element.className =
          "cart-item";


        element.innerHTML = `

          <div class="item-icon">
            ${getIcon(item.name)}
          </div>


          <div>

            <div class="item-name">
              ${escapeHtml(item.name)}
            </div>

            <div class="item-price">
              ${formatPrice(price)} / unité
            </div>


            <div class="quantity">

              <button
                onclick="changeQuantity(${index}, -1)"
                aria-label="Diminuer"
              >
                −
              </button>

              <span>
                ${quantity}
              </span>

              <button
                onclick="changeQuantity(${index}, 1)"
                aria-label="Augmenter"
              >
                +
              </button>

            </div>

          </div>


          <div class="item-actions">

            <div class="item-total">
              ${formatPrice(itemTotal)}
            </div>

            <button
              class="remove"
              onclick="removeItem(${index})"
            >
              Supprimer
            </button>

          </div>

        `;


        cartItems.appendChild(
          element
        );

      });


      document.getElementById(
        "productsCount"
      ).textContent =
        totalQuantity;


      document.getElementById(
        "subtotal"
      ).textContent =
        formatPrice(totalPrice);


      document.getElementById(
        "total"
      ).textContent =
        formatPrice(totalPrice);


      updateHeaderCount();

    }


    /* =========================
       MODIFIER QUANTITÉ
    ========================== */

    function changeQuantity(
      index,
      amount
    ) {

      const cart =
        getCart();


      if (!cart[index]) {
        return;
      }


      cart[index].quantity =
        Number(cart[index].quantity || 1)
        + amount;


      if (
        cart[index].quantity <= 0
      ) {

        cart.splice(index, 1);

      }


      saveCart(cart);

      renderCart();

    }


    /* =========================
       SUPPRIMER
    ========================== */

    function removeItem(index) {

      const cart =
        getCart();


      if (!cart[index]) {
        return;
      }


      cart.splice(
        index,
        1
      );


      saveCart(cart);

      renderCart();

    }


    /* =========================
       VIDER LE PANIER
    ========================== */

    function clearCart() {

      const cart =
        getCart();


      if (
        cart.length === 0
      ) {
        return;
      }


      const confirmation =
        confirm(
          "Voulez-vous vraiment vider votre panier ?"
        );


      if (!confirmation) {
        return;
      }


      localStorage.removeItem(
        CART_KEY
      );


      renderCart();

    }


    /* =========================
       COMPTEUR HEADER
    ========================== */

    function updateHeaderCount() {

      const cart =
        getCart();


      let count = 0;


      cart.forEach(item => {

        count +=
          Number(item.quantity) || 0;

      });


      document.getElementById(
        "cartCount"
      ).textContent =
        count;

    }


    /* =========================
       SÉCURISER LE TEXTE
    ========================== */

    function escapeHtml(text) {

      const div =
        document.createElement(
          "div"
        );

      div.textContent =
        text;

      return div.innerHTML;

    }


    /* =========================
       PASSER COMMANDE
    ========================== */

    function sendOrder() {

      const cart =
        getCart();


      if (
        cart.length === 0
      ) {

        alert(
          "Votre panier est vide."
        );

        return;

      }


      let message =
        "Bonjour Aloïs Design,%0D%0A%0D%0A";

      message +=
        "Je souhaite passer la commande suivante :%0D%0A%0D%0A";


      let total = 0;


      cart.forEach(item => {

        const quantity =
          Number(item.quantity) || 1;

        const price =
          Number(item.price) || 0;

        const itemTotal =
          price * quantity;

        total +=
          itemTotal;


        message +=
          "- " +
          encodeURIComponent(item.name) +
          " x" +
          quantity +
          " : " +
          encodeURIComponent(
            formatPrice(itemTotal)
          ) +
          "%0D%0A";

      });


      message +=
        "%0D%0ATotal produits : " +
        encodeURIComponent(
          formatPrice(total)
        );

      message +=
        "%0D%0A%0D%0A";

      message +=
        "Merci de me confirmer la disponibilité et les frais de livraison.%0D%0A%0D%0A";

      message +=
        "Nom :%0D%0A";

      message +=
        "Adresse :%0D%0A";

      message +=
        "Téléphone :%0D%0A";


      window.location.href =
        "mailto:aloisryckebuschvandaele@gmail.com" +
        "?subject=" +
        encodeURIComponent(
          "Commande Aloïs Design"
        ) +
        "&body=" +
        message;

    }


    /* =========================
       INITIALISATION
    ========================== */

    renderCart();


    window.addEventListener(
      "storage",
      renderCart
    );

  </script>


</body>

</html>
