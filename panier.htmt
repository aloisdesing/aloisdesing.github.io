<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Panier | Alois Design</title>
  <meta name="description" content="Votre panier Alois Design">

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, sans-serif;
      background: #f5f5f5;
      color: #222;
      line-height: 1.6;
    }

    header {
      background: #111;
      color: white;
      text-align: center;
      padding: 22px 15px;
    }

    header h1 {
      font-size: 30px;
    }

    header p {
      color: #ccc;
      margin-top: 5px;
    }

    .container {
      width: 92%;
      max-width: 950px;
      margin: 35px auto;
    }

    h2 {
      text-align: center;
      font-size: 30px;
      margin-bottom: 30px;
    }

    .panier-vide {
      background: white;
      padding: 40px 20px;
      border-radius: 18px;
      text-align: center;
      box-shadow: 0 5px 20px rgba(0,0,0,0.07);
    }

    .panier-vide .icon {
      font-size: 55px;
      margin-bottom: 15px;
    }

    .panier-vide p {
      color: #666;
      margin: 10px 0 25px;
    }

    .produit {
      background: white;
      border-radius: 16px;
      padding: 20px;
      margin-bottom: 15px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.07);

      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
    }

    .produit-info {
      flex: 1;
    }

    .produit-info h3 {
      font-size: 20px;
      margin-bottom: 8px;
    }

    .details {
      color: #666;
      font-size: 14px;
      line-height: 1.7;
    }

    .produit-prix {
      text-align: right;
      min-width: 130px;
    }

    .prix-total {
      font-size: 21px;
      font-weight: bold;
      margin-bottom: 8px;
    }

    .supprimer {
      background: #eee;
      border: none;
      padding: 8px 12px;
      border-radius: 8px;
      cursor: pointer;
      font-weight: bold;
    }

    .supprimer:hover {
      background: #ddd;
    }

    .resume {
      background: white;
      border-radius: 18px;
      padding: 25px;
      margin-top: 25px;
      box-shadow: 0 5px 20px rgba(0,0,0,0.07);
    }

    .ligne {
      display: flex;
      justify-content: space-between;
      margin-bottom: 12px;
      gap: 20px;
    }

    .total {
      border-top: 1px solid #ddd;
      padding-top: 18px;
      margin-top: 15px;

      font-size: 25px;
      font-weight: bold;
    }

    .bouton {
      display: block;
      width: 100%;
      padding: 15px;
      border-radius: 10px;
      border: none;
      text-decoration: none;
      text-align: center;

      font-size: 16px;
      font-weight: bold;
      cursor: pointer;

      margin-top: 15px;
    }

    .bouton-principal {
      background: #111;
      color: white;
    }

    .bouton-secondaire {
      background: #eee;
      color: #111;
    }

    .bouton:hover {
      opacity: 0.9;
    }

    .vider {
      background: transparent;
      border: none;
      color: #777;
      text-decoration: underline;

      cursor: pointer;

      display: block;
      margin: 18px auto 0;
    }

    .retour {
      text-align: center;
      margin-top: 30px;
    }

    .retour a {
      color: #111;
      text-decoration: none;
      font-weight: bold;
    }

    footer {
      background: #111;
      color: #ccc;
      text-align: center;
      padding: 25px 15px;
      margin-top: 50px;
    }

    footer a {
      color: white;
      text-decoration: none;
    }

    @media (max-width: 600px) {

      .produit {
        flex-direction: column;
        align-items: flex-start;
      }

      .produit-prix {
        width: 100%;
        text-align: left;
      }

      .prix-total {
        margin-bottom: 10px;
      }

      .total {
        font-size: 22px;
      }
    }
  </style>
</head>


<body>

<header>

  <h1>Alois Design</h1>

  <p>Votre panier</p>

</header>


<main class="container">

  <h2>🛒 Mon panier</h2>

  <div id="contenuPanier"></div>

</main>


<footer>

  <p>Alois Design</p>

  <p>
    <a href="mailto:aloisryckebuschvandaele@gmail.com">
      aloisryckebuschvandaele@gmail.com
    </a>
  </p>

  <p>
    © 2026 Alois Design - Tous droits réservés
  </p>

</footer>


<script>

  /*
   * RÉCUPÉRATION DU PANIER
   */

  let panier =
    JSON.parse(localStorage.getItem("panier")) || [];


  /*
   * AFFICHER LE PANIER
   */

  function afficherPanier() {

    const contenu =
      document.getElementById("contenuPanier");


    /*
     * PANIER VIDE
     */

    if (panier.length === 0) {

      contenu.innerHTML = `

        <div class="panier-vide">

          <div class="icon">
            🛒
          </div>

          <h3>
            Votre panier est vide
          </h3>

          <p>
            Vous n'avez encore ajouté aucun produit.
          </p>

          <a
            href="impression-3D.html"
            class="bouton bouton-principal"
          >
            Découvrir nos impressions 3D
          </a>

        </div>

      `;

      return;
    }


    let html = "";

    let total = 0;


    /*
     * AFFICHAGE DES PRODUITS
     */

    panier.forEach((produit, index) => {

      const prix =
        Number(produit.prix) || 0;

      const quantite =
        Number(produit.quantite) || 1;

      const sousTotal =
        prix * quantite;


      total += sousTotal;


      let details = "";


      if (produit.texte) {

        details +=
          "Texte : " +
          echapperHTML(produit.texte) +
          "<br>";

      }


      if (produit.couleur) {

        details +=
          "Couleur : " +
          echapperHTML(produit.couleur) +
          "<br>";

      }


      if (produit.taille) {

        details +=
          "Taille : " +
          echapperHTML(produit.taille) +
          "<br>";

      }


      if (produit.imageNom) {

        details +=
          "Dessin : " +
          echapperHTML(produit.imageNom) +
          "<br>";

      }


      html += `

        <div class="produit">

          <div class="produit-info">

            <h3>
              ${echapperHTML(
                produit.nom || "Produit"
              )}
            </h3>

            <div class="details">

              ${details}

              Quantité :
              ${quantite}
              <br>

              Prix unitaire :
              ${formatPrix(prix)}

            </div>

          </div>


          <div class="produit-prix">

            <div class="prix-total">

              ${formatPrix(sousTotal)}

            </div>

            <button
              class="supprimer"
              onclick="supprimerProduit(${index})"
            >
              Supprimer
            </button>

          </div>

        </div>

      `;

    });


    /*
     * RÉSUMÉ
     */

    html += `

      <div class="resume">

        <div class="ligne">

          <span>
            Sous-total
          </span>

          <strong>
            ${formatPrix(total)}
          </strong>

        </div>


        <div class="ligne">

          <span>
            Livraison
          </span>

          <span>
            À calculer
          </span>

        </div>


        <div class="ligne total">

          <span>
            Total
          </span>

          <span>
            ${formatPrix(total)}
          </span>

        </div>


        <a
          href="impression-3D.html"
          class="bouton bouton-secondaire"
        >
          ← Continuer mes achats
        </a>


        <button
          class="bouton bouton-principal"
          onclick="passerCommande()"
        >
          Commander
        </button>


        <button
          class="vider"
          onclick="viderPanier()"
        >
          Vider le panier
        </button>

      </div>

    `;


    contenu.innerHTML = html;

  }


  /*
   * SUPPRIMER UN PRODUIT
   */

  function supprimerProduit(index) {

    panier.splice(index, 1);

    sauvegarderPanier();

    afficherPanier();

  }


  /*
   * VIDER LE PANIER
   */

  function viderPanier() {

    if (
      !confirm(
        "Voulez-vous vraiment vider votre panier ?"
      )
    ) {

      return;

    }


    panier = [];

    sauvegarderPanier();

    afficherPanier();

  }


  /*
   * SAUVEGARDER LE PANIER
   */

  function sauvegarderPanier() {

    localStorage.setItem(
      "panier",
      JSON.stringify(panier)
    );

  }


  /*
   * FORMAT PRIX
   */

  function formatPrix(prix) {

    return (
      prix
        .toFixed(2)
        .replace(".", ",") +
      " €"
    );

  }


  /*
   * PROTECTION DU TEXTE
   */

  function echapperHTML(texte) {

    return String(texte)

      .replace(/&/g, "&amp;")

      .replace(/</g, "&lt;")

      .replace(/>/g, "&gt;")

      .replace(/"/g, "&quot;")

      .replace(/'/g, "&#039;");

  }


  /*
   * PASSER COMMANDE
   */

  function passerCommande() {

    if (panier.length === 0) {

      alert(
        "Votre panier est vide."
      );

      return;

    }


    /*
     * PAGE DE COMMANDE
     */

    window.location.href =
      "commande.html";

  }


  /*
   * AFFICHER AU CHARGEMENT
   */

  afficherPanier();

</script>

</body>
</html>
