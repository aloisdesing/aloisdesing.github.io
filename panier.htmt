<!DOCTYPE html>
<html lang="fr">
<head>

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Panier | Aloïs Design</title>

  <meta
    name="description"
    content="Votre panier Aloïs Design."
  >

  <style>

    :root {
      --bg: #090909;
      --bg-light: #121212;
      --card: #171717;
      --gold: #d9a72b;
      --gold-light: #f3cc68;
      --white: #ffffff;
      --gray: #aaaaaa;
      --border: #292929;
      --danger: #d9534f;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: var(--bg);
      color: var(--white);
      line-height: 1.6;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button,
    input {
      font: inherit;
    }

    .container {
      width: min(1120px, 92%);
      margin: auto;
    }

    /* =========================
       HEADER
    ========================== */

    header {
      position: sticky;
      top: 0;
      z-index: 100;

      background: rgba(9, 9, 9, 0.96);

      backdrop-filter: blur(12px);

      border-bottom: 1px solid var(--border);
    }

    nav {
      min-height: 72px;

      display: flex;
      align-items: center;
      justify-content: space-between;

      gap: 15px;
    }

    .logo {
      font-size: 20px;
      font-weight: 900;

      letter-spacing: 2px;

      color: var(--gold);

      white-space: nowrap;
    }

    .logo span {
      color: white;
    }

    .nav-links {
      display: flex;
      align-items: center;

      gap: 20px;

      font-size: 14px;

      color: #ddd;
    }

    .nav-links a:hover {
      color: var(--gold-light);
    }

    /* =========================
       PANIER HEADER
    ========================== */

    .cart-link {
      position: relative;

      display: flex;
      align-items: center;
      justify-content: center;

      width: 42px;
      height: 42px;

      border: 1px solid var(--gold);

      border-radius: 10px;

      background: #111;
    }

    .cart-icon {
      width: 25px;
      height: 25px;

      fill: none;

      stroke: var(--gold-light);

      stroke-width: 2;

      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .cart-count {
      position: absolute;

      top: -7px;
      right: -7px;

      min-width: 20px;
      height: 20px;

      padding: 2px 5px;

      border-radius: 50%;

      background: var(--gold);

      color: #111;

      font-size: 11px;

      font-weight: 900;

      text-align: center;
    }

    /* =========================
       BOUTONS
    ========================== */

    .btn {
      display: inline-block;

      padding: 13px 20px;

      border-radius: 10px;

      background: var(--gold);

      border: 1px solid var(--gold);

      color: #111;

      font-weight: 900;

      cursor: pointer;

      transition: 0.2s;
    }

    .btn:hover {
      background: var(--gold-light);

      border-color: var(--gold-light);
    }

    .btn-secondary {
      background: transparent;

      border-color: #444;

      color: white;
    }

    .btn-secondary:hover {
      border-color: var(--gold);

      color: var(--gold-light);

      background: transparent;
    }

    .btn-danger {
      background: transparent;

      border-color: #633;

      color: #ff7777;

      padding: 8px 12px;

      font-size: 13px;
    }

    .btn-danger:hover {
      background: #301010;

      border-color: #a44;

      color: #ff9999;
    }

    /* =========================
       HERO
    ========================== */

    .hero {
      padding: 90px 0 60px;

      background:
        radial-gradient(
          circle at 80% 20%,
          #30240c 0,
          transparent 35%
        );
    }

    .kicker {
      color: var(--gold-light);

      text-transform: uppercase;

      letter-spacing: 2px;

      font-size: 13px;

      font-weight: 800;

      margin-bottom: 15px;
    }

    .hero h1 {
      font-size: clamp(42px, 7vw, 68px);

      line-height: 1.02;

      margin-bottom: 18px;
    }

    .hero h1 span {
      color: var(--gold);
    }

    .hero p {
      max-width: 700px;

      color: var(--gray);

      font-size: 18px;
    }

    /* =========================
       PANIER
    ========================== */

    section {
      padding: 50px 0 80px;
    }

    .cart-layout {
      display: grid;

      grid-template-columns: 1fr 340px;

      gap: 25px;

      align-items: start;
    }

    .cart-list {
      display: flex;

      flex-direction: column;

      gap: 15px;
    }

    .cart-item {
      display: grid;

      grid-template-columns: 1fr auto;

      gap: 20px;

      padding: 25px;

      border: 1px solid var(--border);

      border-radius: 18px;

      background:
        linear-gradient(
          145deg,
          #181818,
          #101010
        );
    }

    .item-name {
      color: var(--gold-light);

      font-size: 21px;

      font-weight: 900;

      margin-bottom: 6px;
    }

    .item-info {
      color: var(--gray);

      font-size: 14px;
    }

    .item-price {
      margin-top: 10px;

      color: white;

      font-weight: 900;
    }

    .item-right {
      text-align: right;
    }

    .item-total {
      color: var(--gold-light);

      font-size: 20px;

      font-weight: 900;

      margin-bottom: 10px;
    }

    .quantity {
      display: flex;

      align-items: center;

      justify-content: flex-end;

      gap: 8px;

      margin-bottom: 12px;
    }

    .quantity button {
      width: 32px;
      height: 32px;

      border-radius: 8px;

      border: 1px solid #444;

      background: #0b0b0b;

      color: white;

      cursor: pointer;

      font-weight: 900;
    }

    .quantity button:hover {
      border-color: var(--gold);

      color: var(--gold-light);
    }

    .quantity span {
      min-width: 25px;

      text-align: center;

      font-weight: 900;
    }

    /* =========================
       TOTAL
    ========================== */

    .summary {
      position: sticky;

      top: 95px;

      padding: 30px;

      border: 1px solid var(--border);

      border-radius: 18px;

      background:
        linear-gradient(
          145deg,
          #171207,
          #101010
        );
    }

    .summary h2 {
      font-size: 25px;

      margin-bottom: 20px;
    }

    .summary-line {
      display: flex;

      justify-content: space-between;

      gap: 15px;

      padding: 12px 0;

      border-bottom: 1px solid #292929;

      color: #ddd;
    }

    .summary-total {
      display: flex;

      justify-content: space-between;

      gap: 15px;

      padding: 20px 0;

      font-size: 23px;

      font-weight: 900;
    }

    .summary-total span:last-child {
      color: var(--gold-light);
    }

    .summary .btn {
      width: 100%;

      text-align: center;

      margin-top: 10px;
    }

    .empty {
      padding: 60px 30px;

      border: 1px solid var(--border);

      border-radius: 18px;

      background: var(--card);

      text-align: center;
    }

    .empty-icon {
      font-size: 55px;

      margin-bottom: 15px;
    }

    .empty h2 {
      margin-bottom: 10px;
    }

    .empty p {
      color: var(--gray);

      margin-bottom: 25px;
    }

    /* =========================
       FOOTER
    ========================== */

    footer {
      border-top: 1px solid var(--border);

      padding: 35px 0;

      text-align: center;

      color: #888;

      font-size: 13px;
    }

    footer a {
      color: var(--gold-light);
    }

    /* =========================
       MOBILE
    ========================== */

    @media (max-width: 850px) {

      .nav-links {
        display: none;
      }

      .cart-layout {
        grid-template-columns: 1fr;
      }

      .summary {
        position: static;
      }

    }

    @media (max-width: 550px) {

      .container {
        width: 90%;
      }

      .hero {
        padding-top: 70px;
      }

      .hero h1 {
        font-size: 42px;
      }

      .hero p {
        font-size: 17px;
      }

      .cart-item {
        grid-template-columns: 1fr;
      }

      .item-right {
        text-align: left;
      }

      .quantity {
        justify-content: flex-start;
      }

    }

  </style>

</head>


<body>


<!-- =========================
     HEADER
========================== -->

<header>

  <div class="container">

    <nav>

      <a
        href="index.html"
        class="logo"
      >
        ALOÏS <span>DESIGN</span>
      </a>


      <div class="nav-links">

        <a href="index.html">
          Accueil
        </a>

        <a href="impression-3d.html">
          Impression 3D
        </a>

        <a href="logo3D.html">
          Logo 3D
        </a>

        <a href="porte-clé.html">
          Porte-clé
        </a>

        <a href="tampons.html">
          Tampons
        </a>

      </div>


      <a
        href="panier.html"
        class="cart-link"
        aria-label="Panier"
      >

        <svg
          class="cart-icon"
          viewBox="0 0 24 24"
        >

          <circle
            cx="9"
            cy="20"
            r="1.5"
          ></circle>

          <circle
            cx="18"
            cy="20"
            r="1.5"
          ></circle>

          <path
            d="M3 4h2l2.2 11.2a2 2 0 0 0 2 1.6h7.8a2 2 0 0 0 1.9-1.4L21 8H6"
          ></path>

        </svg>

        <span
          class="cart-count"
          id="cartCount"
        >
          0
        </span>

      </a>

    </nav>

  </div>

</header>



<main>


<!-- =========================
     HERO
========================== -->

<section class="hero">

  <div class="container">

    <div class="kicker">
      ALOÏS DESIGN
    </div>

    <h1>
      Mon <span>panier.</span>
    </h1>

    <p>
      Retrouvez ici tous les produits que vous
      avez sélectionnés avant de passer votre commande.
    </p>

  </div>

</section>



<!-- =========================
     CONTENU PANIER
========================== -->

<section>

  <div class="container">

    <div id="cartContent"></div>

  </div>

</section>


</main>



<!-- =========================
     FOOTER
========================== -->

<footer>

  <div class="container">

    <p>
      Aloïs Design
    </p>

    <p>
      Impression 3D · Création de logos ·
      Sculpture & gravure
    </p>

    <p style="margin-top: 10px;">

      <a
        href="mailto:aloisryckebuschvandaele@gmail.com"
      >
        aloisryckebuschvandaele@gmail.com
      </a>

    </p>

    <p style="margin-top: 10px;">
      © 2026 Aloïs Design
    </p>

  </div>

</footer>



<!-- =========================
     JAVASCRIPT PANIER
========================== -->

<script>

  const CART_KEY = "aloisDesignCart";


  function getCart() {

    try {

      return JSON.parse(
        localStorage.getItem(CART_KEY)
      ) || [];

    } catch (error) {

      return [];

    }

  }


  function saveCart(cart) {

    localStorage.setItem(
      CART_KEY,
      JSON.stringify(cart)
    );

  }


  function getQuantity(item) {

    return Number(
      item.quantity ??
      item.quantite ??
      1
    ) || 1;

  }


  function getPrice(item) {

    return Number(
      item.price ??
      item.prix ??
      0
    ) || 0;

  }


  function getName(item) {

    return (
      item.name ??
      item.nom ??
      item.title ??
      "Produit"
    );

  }


  function updateHeaderCount(cart) {

    const countElement =
      document.getElementById("cartCount");

    let total = 0;

    cart.forEach(function(item) {

      total += getQuantity(item);

    });

    countElement.textContent = total;

  }


  function changeQuantity(index, change) {

    const cart = getCart();

    if (!cart[index]) {
      return;
    }

    let quantity =
      getQuantity(cart[index]);

    quantity += change;

    if (quantity <= 0) {

      cart.splice(index, 1);

    } else {

      cart[index].quantity = quantity;

      cart[index].quantite = quantity;

    }

    saveCart(cart);

    renderCart();

  }


  function removeItem(index) {

    const cart = getCart();

    cart.splice(index, 1);

    saveCart(cart);

    renderCart();

  }


  function clearCart() {

    localStorage.removeItem(CART_KEY);

    renderCart();

  }


  function renderCart() {

    const cart =
      getCart();

    const container =
      document.getElementById("cartContent");


    updateHeaderCount(cart);


    if (cart.length === 0) {

      container.innerHTML = `

        <div class="empty">

          <div class="empty-icon">
            🛒
          </div>

          <h2>
            Votre panier est vide
          </h2>

          <p>
            Vous n'avez encore ajouté aucun produit.
          </p>

          <a
            href="impression-3d.html"
            class="btn"
          >
            Découvrir les produits
          </a>

        </div>

      `;

      return;

    }


    let total = 0;

    let totalQuantity = 0;


    let productsHTML = "";


    cart.forEach(function(item, index) {

      const name =
        getName(item);

      const price =
        getPrice(item);

      const quantity =
        getQuantity(item);

      const itemTotal =
        price * quantity;


      total += itemTotal;

      totalQuantity += quantity;


      productsHTML += `

        <article class="cart-item">

          <div>

            <div class="item-name">
              ${escapeHTML(name)}
            </div>

            <div class="item-info">

              Prix unitaire :
              ${formatPrice(price)}

            </div>

            ${
              item.description
                ? `
                  <div class="item-info" style="margin-top:6px;">
                    ${escapeHTML(item.description)}
                  </div>
                `
                : ""
            }

          </div>


          <div class="item-right">

            <div class="item-total">
              ${formatPrice(itemTotal)}
            </div>


            <div class="quantity">

              <button
                onclick="changeQuantity(${index}, -1)"
                aria-label="Diminuer"
              >
                −
              </button>

              <span>
                ${quantity}
              </span>

              <button
                onclick="changeQuantity(${index}, 1)"
                aria-label="Augmenter"
              >
                +
              </button>

            </div>


            <button
              class="btn btn-danger"
              onclick="removeItem(${index})"
            >
              Supprimer
            </button>

          </div>

        </article>

      `;

    });


    container.innerHTML = `

      <div class="cart-layout">


        <div class="cart-list">

          ${productsHTML}


          <div style="margin-top: 5px;">

            <button
              class="btn btn-danger"
              onclick="clearCart()"
            >
              Vider le panier
            </button>

          </div>

        </div>


        <aside class="summary">

          <h2>
            Résumé
          </h2>


          <div class="summary-line">

            <span>
              Produits
            </span>

            <span>
              ${totalQuantity}
            </span>

          </div>


          <div class="summary-line">

            <span>
              Sous-total
            </span>

            <span>
              ${formatPrice(total)}
            </span>

          </div>


          <div class="summary-line">

            <span>
              Livraison
            </span>

            <span>
              À définir
            </span>

          </div>


          <div class="summary-total">

            <span>
              Total
            </span>

            <span>
              ${formatPrice(total)}
            </span>

          </div>


          <a
            href="commande.html"
            class="btn"
          >
            Passer la commande
          </a>


          <a
            href="impression-3d.html"
            class="btn btn-secondary"
            style="margin-top: 12px;"
          >
            Continuer mes achats
          </a>

        </aside>


      </div>

    `;

  }


  function formatPrice(price) {

    return Number(price).toLocaleString(
      "fr-FR",
      {
        style: "currency",
        currency: "EUR"
      }
    );

  }


  function escapeHTML(value) {

    return String(value)
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");

  }


  renderCart();


  window.addEventListener(
    "storage",
    renderCart
  );

</script>


</body>
</html>
