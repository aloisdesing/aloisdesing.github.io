<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Panier | Aloïs Design</title>

  <meta
    name="description"
    content="Votre panier Aloïs Design."
  >

  <style>
    :root {
      --bg: #090909;
      --bg-light: #121212;
      --card: #171717;
      --gold: #d9a72b;
      --gold-light: #f3cc68;
      --white: #ffffff;
      --gray: #aaaaaa;
      --border: #292929;
      --danger: #d9534f;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: var(--bg);
      color: var(--white);
      line-height: 1.6;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button,
    input,
    textarea {
      font-family: inherit;
    }

    .container {
      width: min(1120px, 92%);
      margin: auto;
    }

    /* =========================
       HEADER
    ========================== */

    header {
      position: sticky;
      top: 0;
      z-index: 100;

      background: rgba(9, 9, 9, 0.96);

      backdrop-filter: blur(12px);

      border-bottom: 1px solid var(--border);
    }

    nav {
      min-height: 72px;

      display: flex;
      align-items: center;
      justify-content: space-between;

      gap: 15px;
    }

    .logo {
      font-size: 20px;
      font-weight: 900;
      letter-spacing: 2px;

      color: var(--gold);

      white-space: nowrap;
    }

    .logo span {
      color: white;
    }

    .nav-links {
      display: flex;
      align-items: center;

      gap: 18px;

      font-size: 14px;

      color: #ddd;
    }

    .nav-links a:hover {
      color: var(--gold-light);
    }

    /* =========================
       PANIER HEADER
    ========================== */

    .cart-link {
      position: relative;

      display: flex;
      align-items: center;
      justify-content: center;

      width: 44px;
      height: 44px;

      border: 1px solid var(--gold);

      border-radius: 10px;

      background: #111;
    }

    .cart-icon {
      width: 25px;
      height: 25px;

      fill: none;

      stroke: var(--gold-light);

      stroke-width: 2;

      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .cart-count {
      position: absolute;

      top: -7px;
      right: -7px;

      min-width: 20px;
      height: 20px;

      padding: 2px 5px;

      border-radius: 50%;

      background: var(--gold);

      color: #111;

      font-size: 11px;

      font-weight: 900;

      text-align: center;
    }

    /* =========================
       HERO
    ========================== */

    .hero {
      padding: 90px 0 60px;

      background:
        radial-gradient(
          circle at 80% 20%,
          #30240c 0,
          transparent 35%
        );
    }

    .kicker {
      color: var(--gold-light);

      text-transform: uppercase;

      letter-spacing: 2px;

      font-size: 13px;

      font-weight: 800;

      margin-bottom: 12px;
    }

    .hero h1 {
      font-size: clamp(42px, 7vw, 70px);

      line-height: 1.05;

      margin-bottom: 18px;
    }

    .hero h1 span {
      color: var(--gold);
    }

    .hero p {
      color: var(--gray);

      font-size: 18px;
    }

    /* =========================
       PANIER
    ========================== */

    .cart-section {
      padding: 50px 0 90px;
    }

    .cart-layout {
      display: grid;

      grid-template-columns: 1.5fr 0.8fr;

      gap: 25px;

      align-items: start;
    }

    /* =========================
       PRODUITS
    ========================== */

    .cart-products {
      display: flex;

      flex-direction: column;

      gap: 15px;
    }

    .cart-item {
      display: grid;

      grid-template-columns: 90px 1fr auto;

      gap: 20px;

      align-items: center;

      padding: 22px;

      border: 1px solid var(--border);

      border-radius: 18px;

      background:
        linear-gradient(
          145deg,
          #181818,
          #101010
        );
    }

    .product-icon {
      width: 90px;
      height: 90px;

      display: flex;

      align-items: center;
      justify-content: center;

      border-radius: 15px;

      background: #0d0d0d;

      border: 1px solid #333;

      font-size: 38px;
    }

    .item-name {
      font-size: 20px;

      font-weight: 900;

      margin-bottom: 5px;
    }

    .item-price {
      color: var(--gold-light);

      font-weight: 900;

      margin-bottom: 8px;
    }

    .customization {
      color: #999;

      font-size: 13px;

      margin-top: 8px;
    }

    .customization strong {
      color: #ddd;
    }

    .item-actions {
      display: flex;

      align-items: center;

      gap: 8px;

      margin-top: 12px;
    }

    .quantity-button {
      width: 32px;
      height: 32px;

      border-radius: 7px;

      border: 1px solid #444;

      background: #0a0a0a;

      color: white;

      cursor: pointer;

      font-size: 18px;
    }

    .quantity-button:hover {
      border-color: var(--gold);

      color: var(--gold-light);
    }

    .quantity-number {
      min-width: 35px;

      text-align: center;

      font-weight: 800;
    }

    .item-total {
      text-align: right;

      font-size: 20px;

      font-weight: 900;

      color: var(--gold-light);

      white-space: nowrap;
    }

    .remove-button {
      display: block;

      margin-top: 10px;

      border: none;

      background: transparent;

      color: #888;

      cursor: pointer;

      font-size: 12px;
    }

    .remove-button:hover {
      color: #ff7777;
    }

    /* =========================
       RÉSUMÉ
    ========================== */

    .summary {
      padding: 28px;

      border: 1px solid var(--border);

      border-radius: 18px;

      background:
        linear-gradient(
          145deg,
          #181818,
          #101010
        );

      position: sticky;

      top: 95px;
    }

    .summary h2 {
      font-size: 25px;

      margin-bottom: 25px;
    }

    .summary-line {
      display: flex;

      align-items: center;

      justify-content: space-between;

      gap: 20px;

      padding: 10px 0;

      color: #ccc;
    }

    .summary-line.total {
      margin-top: 15px;

      padding-top: 20px;

      border-top: 1px solid var(--border);

      color: white;

      font-size: 22px;

      font-weight: 900;
    }

    .total-price {
      color: var(--gold-light);
    }

    /* =========================
       BOUTONS
    ========================== */

    .btn {
      display: block;

      width: 100%;

      padding: 14px 20px;

      margin-top: 18px;

      border-radius: 10px;

      background: var(--gold);

      border: 1px solid var(--gold);

      color: #111;

      font-weight: 900;

      text-align: center;

      cursor: pointer;

      transition: 0.2s;
    }

    .btn:hover {
      background: var(--gold-light);

      border-color: var(--gold-light);
    }

    .btn-secondary {
      background: transparent;

      border-color: #444;

      color: white;
    }

    .btn-secondary:hover {
      background: transparent;

      border-color: var(--gold);

      color: var(--gold-light);
    }

    .btn-danger {
      background: transparent;

      border-color: #4b2424;

      color: #ff7777;
    }

    .btn-danger:hover {
      background: #251010;

      border-color: #ff5555;

      color: #ff7777;
    }

    /* =========================
       FORMULAIRE COMMANDE
    ========================== */

    .order-form {
      margin-top: 25px;

      padding: 28px;

      border: 1px solid var(--border);

      border-radius: 18px;

      background: #101010;
    }

    .order-form h2 {
      font-size: 26px;

      margin-bottom: 8px;
    }

    .order-form > p {
      color: var(--gray);

      font-size: 14px;

      margin-bottom: 20px;
    }

    .form-grid {
      display: grid;

      grid-template-columns: 1fr 1fr;

      gap: 15px;
    }

    .form-group {
      margin-bottom: 5px;
    }

    .form-group.full {
      grid-column: 1 / -1;
    }

    .form-group label {
      display: block;

      margin-bottom: 7px;

      color: #ddd;

      font-size: 14px;

      font-weight: 700;
    }

    .form-group input,
    .form-group textarea {
      width: 100%;

      padding: 12px;

      border-radius: 9px;

      border: 1px solid #333;

      background: #080808;

      color: white;

      outline: none;
    }

    .form-group input:focus,
    .form-group textarea:focus {
      border-color: var(--gold);

      outline: 1px solid var(--gold);
    }

    .form-group textarea {
      min-height: 100px;

      resize: vertical;
    }

    /* =========================
       PANIER VIDE
    ========================== */

    .empty-cart {
      padding: 70px 25px;

      text-align: center;

      border: 1px solid var(--border);

      border-radius: 18px;

      background: var(--card);
    }

    .empty-icon {
      font-size: 60px;

      margin-bottom: 15px;
    }

    .empty-cart h2 {
      font-size: 28px;

      margin-bottom: 8px;
    }

    .empty-cart p {
      color: var(--gray);

      margin-bottom: 25px;
    }

    .empty-cart .btn {
      display: inline-block;

      width: auto;

      margin: 0;

      padding-left: 25px;

      padding-right: 25px;
    }

    /* =========================
       FOOTER
    ========================== */

    footer {
      border-top: 1px solid var(--border);

      padding: 35px 0;

      text-align: center;

      color: #888;

      font-size: 13px;
    }

    .gold {
      color: var(--gold-light);
    }

    /* =========================
       MOBILE
    ========================== */

    @media (max-width: 850px) {

      .nav-links {
        display: none;
      }

      .cart-layout {
        grid-template-columns: 1fr;
      }

      .summary {
        position: static;
      }

    }

    @media (max-width: 600px) {

      .container {
        width: 90%;
      }

      .hero {
        padding-top: 70px;
      }

      .cart-item {
        grid-template-columns: 70px 1fr;

        gap: 15px;
      }

      .product-icon {
        width: 70px;
        height: 70px;

        font-size: 30px;
      }

      .item-total {
        grid-column: 2;

        text-align: left;
      }

      .form-grid {
        grid-template-columns: 1fr;
      }

      .form-group.full {
        grid-column: auto;
      }

    }

  </style>
</head>


<body>


  <!-- =========================
       HEADER
  ========================== -->

  <header>

    <div class="container">

      <nav>

        <a
          href="index.html"
          class="logo"
        >
          ALOÏS <span>DESIGN</span>
        </a>


        <div class="nav-links">

          <a href="index.html">
            Accueil
          </a>

          <a href="impression-3d.html">
            Impression 3D
          </a>

          <a href="Logo3D.html">
            Logo 3D
          </a>

          <a href="porte-cle.html">
            Porte-clé
          </a>

          <a href="tampons.html">
            Tampons
          </a>

          <a href="creation-logo.html">
            Création de logo
          </a>

        </div>


        <a
          href="panier.html"
          class="cart-link"
          aria-label="Panier"
        >

          <svg
            class="cart-icon"
            viewBox="0 0 24 24"
          >

            <circle
              cx="9"
              cy="20"
              r="1.5"
            ></circle>

            <circle
              cx="18"
              cy="20"
              r="1.5"
            ></circle>

            <path
              d="M3 4h2l2.2 11.2a2 2 0 0 0 2 1.6h7.8a2 2 0 0 0 1.9-1.4L21 8H6"
            ></path>

          </svg>

          <span
            class="cart-count"
            id="headerCartCount"
          >
            0
          </span>

        </a>

      </nav>

    </div>

  </header>


  <main>


    <!-- =========================
         HERO
    ========================== -->

    <section class="hero">

      <div class="container">

        <div class="kicker">
          Aloïs Design
        </div>

        <h1>
          Votre <span>panier.</span>
        </h1>

        <p>
          Retrouvez ici tous les produits que vous avez
          sélectionnés avant d'envoyer votre commande.
        </p>

      </div>

    </section>


    <!-- =========================
         PANIER
    ========================== -->

    <section class="cart-section">

      <div class="container">

        <!-- PANIER AVEC PRODUITS -->

        <div
          id="cartContent"
        >

          <div class="cart-layout">


            <!-- PRODUITS -->

            <div>

              <div
                class="cart-products"
                id="cartProducts"
              ></div>


              <!-- FORMULAIRE -->

              <div class="order-form">

                <h2>
                  📦 Informations de commande
                </h2>

                <p>
                  Remplissez vos coordonnées avant d'envoyer
                  votre demande de commande.
                </p>


                <div class="form-grid">


                  <div class="form-group">

                    <label for="customerName">
                      Nom / prénom
                    </label>

                    <input
                      type="text"
                      id="customerName"
                      placeholder="Votre nom et prénom"
                    >

                  </div>


                  <div class="form-group">

                    <label for="customerEmail">
                      Email
                    </label>

                    <input
                      type="email"
                      id="customerEmail"
                      placeholder="Votre adresse e-mail"
                    >

                  </div>


                  <div class="form-group full">

                    <label for="customerAddress">
                      Adresse de livraison
                    </label>

                    <input
                      type="text"
                      id="customerAddress"
                      placeholder="Rue, numéro, ville, code postal"
                    >

                  </div>


                  <div class="form-group full">

                    <label for="customerMessage">
                      Message complémentaire
                    </label>

                    <textarea
                      id="customerMessage"
                      placeholder="Une précision concernant votre commande..."
                    ></textarea>

                  </div>


                </div>

              </div>

            </div>


            <!-- RÉSUMÉ -->

            <aside class="summary">

              <h2>
                Résumé
              </h2>


              <div class="summary-line">

                <span>
                  Articles
                </span>

                <strong id="summaryItems">
                  0
                </strong>

              </div>


              <div class="summary-line">

                <span>
                  Sous-total
                </span>

                <strong id="summarySubtotal">
                  0,00 €
                </strong>

              </div>


              <div class="summary-line">

                <span>
                  Livraison
                </span>

                <span>
                  À confirmer
                </span>

              </div>


              <div class="summary-line total">

                <span>
                  Total produits
                </span>

                <span
                  class="total-price"
                  id="summaryTotal"
                >
                  0,00 €
                </span>

              </div>


              <button
                class="btn"
                onclick="sendOrder()"
              >
                📩 Envoyer ma commande
              </button>


              <a
                href="impression-3d.html"
                class="btn btn-secondary"
              >
                Continuer mes achats
              </a>


              <button
                class="btn btn-danger"
                onclick="clearCart()"
              >
                🗑️ Vider le panier
              </button>

            </aside>


          </div>

        </div>


        <!-- PANIER VIDE -->

        <div
          class="empty-cart"
          id="emptyCart"
          style="display: none;"
        >

          <div class="empty-icon">
            🛒
          </div>

          <h2>
            Votre panier est vide
          </h2>

          <p>
            Ajoutez un produit à votre panier
            pour commencer votre commande.
          </p>

          <a
            href="impression-3d.html"
            class="btn"
          >
            Voir l'impression 3D
          </a>

        </div>

      </div>

    </section>

  </main>


  <!-- =========================
       FOOTER
  ========================== -->

  <footer>

    <div class="container">

      © 2026 Aloïs Design

      <br>

      Impression 3D · Création de logos · Sculpture & gravure

      <br><br>

      <a
        href="mailto:aloisryckebuschvandaele@gmail.com"
        class="gold"
      >
        aloisryckebuschvandaele@gmail.com
      </a>

    </div>

  </footer>


  <!-- =========================
       JAVASCRIPT PANIER
  ========================== -->

  <script>

    const CART_KEY =
      "aloisDesignCart";


    /* =========================
       RÉCUPÉRER LE PANIER
    ========================== */

    function getCart() {

      try {

        return JSON.parse(
          localStorage.getItem(
            CART_KEY
          )
        ) || [];

      } catch (error) {

        return [];

      }

    }


    /* =========================
       SAUVEGARDER
    ========================== */

    function saveCart(cart) {

      localStorage.setItem(
        CART_KEY,
        JSON.stringify(cart)
      );

    }


    /* =========================
       FORMAT PRIX
    ========================== */

    function formatPrice(price) {

      return Number(price).toFixed(2)
        .replace(".", ",") + " €";

    }


    /* =========================
       ICÔNE PRODUIT
    ========================== */

    function getProductIcon(name) {

      const product =
        name.toLowerCase();

      if (
        product.includes("porte-clé") ||
        product.includes("porte-cle")
      ) {

        return "🔑";

      }

      if (
        product.includes("logo")
      ) {

        return "🎨";

      }

      if (
        product.includes("tampon")
      ) {

        return "🔖";

      }

      if (
        product.includes("impression")
      ) {

        return "🖨️";

      }

      return "📦";

    }


    /* =========================
       AFFICHER LE PANIER
    ========================== */

    function renderCart() {

      const cart =
        getCart();


      const products =
        document.getElementById(
          "cartProducts"
        );


      const cartContent =
        document.getElementById(
          "cartContent"
        );


      const emptyCart =
        document.getElementById(
          "emptyCart"
        );


      if (
        cart.length === 0
      ) {

        cartContent.style.display =
          "none";

        emptyCart.style.display =
          "block";

        updateHeaderCount();

        return;

      }


      cartContent.style.display =
        "block";

      emptyCart.style.display =
        "none";


      products.innerHTML =
        "";


      let totalItems = 0;

      let totalPrice = 0;


      cart.forEach(
        (item, index) => {

          const quantity =
            Number(item.quantity) || 1;

          const price =
            Number(item.price) || 0;

          const itemTotal =
            price * quantity;


          totalItems +=
            quantity;

          totalPrice +=
            itemTotal;


          let customizationHTML =
            "";


          if (
            item.customization
          ) {

            if (
              item.customization.text
            ) {

              customizationHTML +=
                `<strong>Texte :</strong> ${
                  escapeHTML(
                    item.customization.text
                  )
                }<br>`;

            }


            if (
              item.customization.color
            ) {

              customizationHTML +=
                `<strong>Couleur :</strong> ${
                  escapeHTML(
                    item.customization.color
                  )
                }<br>`;

            }


            if (
              item.customization.description
            ) {

              customizationHTML +=
                `<strong>Personnalisation :</strong> ${
                  escapeHTML(
                    item.customization.description
                  )
                }`;

            }

          }


          if (
            item.options
          ) {

            customizationHTML +=
              `<strong>Options :</strong> ${
                escapeHTML(
                  JSON.stringify(
                    item.options
                  )
                )
              }`;

          }


          const div =
            document.createElement(
              "div"
            );


          div.className =
            "cart-item";


          div.innerHTML = `

            <div class="product-icon">
              ${getProductIcon(item.name || "Produit")}
            </div>

            <div>

              <div class="item-name">
                ${escapeHTML(item.name || "Produit")}
              </div>

              <div class="item-price">
                ${formatPrice(price)} / unité
              </div>

              ${
                customizationHTML
                  ? `
                    <div class="customization">
                      ${customizationHTML}
                    </div>
                  `
                  : ""
              }

              <div class="item-actions">

                <button
                  class="quantity-button"
                  onclick="changeItemQuantity(${index}, -1)"
                >
                  −
                </button>

                <span class="quantity-number">
                  ${quantity}
                </span>

                <button
                  class="quantity-button"
                  onclick="changeItemQuantity(${index}, 1)"
                >
                  +
                </button>

              </div>

              <button
                class="remove-button"
                onclick="removeItem(${index})"
              >
                Supprimer ce produit
              </button>

            </div>

            <div class="item-total">
              ${formatPrice(itemTotal)}
            </div>

          `;


          products.appendChild(div);

        }
      );


      document.getElementById(
        "summaryItems"
      ).textContent =
        totalItems;


      document.getElementById(
        "summarySubtotal"
      ).textContent =
        formatPrice(totalPrice);


      document.getElementById(
        "summaryTotal"
      ).textContent =
        formatPrice(totalPrice);


      updateHeaderCount();

    }


    /* =========================
       MODIFIER QUANTITÉ
    ========================== */

    function changeItemQuantity(
      index,
      amount
    ) {

      const cart =
        getCart();


      if (!cart[index]) {
        return;
      }


      let quantity =
        Number(
          cart[index].quantity
        ) || 1;


      quantity +=
        amount;


      if (
        quantity <= 0
      ) {

        cart.splice(
          index,
          1
        );

      } else {

        cart[index].quantity =
          quantity;

      }


      saveCart(cart);

      renderCart();

    }


    /* =========================
       SUPPRIMER
    ========================== */

    function removeItem(index) {

      const cart =
        getCart();


      if (!cart[index]) {
        return;
      }


      cart.splice(
        index,
        1
      );


      saveCart(cart);

      renderCart();

    }


    /* =========================
       VIDER
    ========================== */

    function clearCart() {

      const cart =
        getCart();


      if (
        cart.length === 0
      ) {

        return;

      }


      const confirmation =
        confirm(
          "Voulez-vous vraiment vider votre panier ?"
        );


      if (
        !confirmation
      ) {

        return;

      }


      localStorage.removeItem(
        CART_KEY
      );


      renderCart();

    }


    /* =========================
       COMPTEUR HEADER
    ========================== */

    function updateHeaderCount() {

      const cart =
        getCart();


      let count = 0;


      cart.forEach(
        item => {

          count +=
            Number(
              item.quantity
            ) || 0;

        }
      );


      document.getElementById(
        "headerCartCount"
      ).textContent =
        count;

    }


    /* =========================
       ENVOYER LA COMMANDE
    ========================== */

    function sendOrder() {

      const cart =
        getCart();


      if (
        cart.length === 0
      ) {

        alert(
          "Votre panier est vide."
        );

        return;

      }


      const name =
        document
          .getElementById(
            "customerName"
          )
          .value
          .trim();


      const email =
        document
          .getElementById(
            "customerEmail"
          )
          .value
          .trim();


      const address =
        document
          .getElementById(
            "customerAddress"
          )
          .value
          .trim();


      const message =
        document
          .getElementById(
            "customerMessage"
          )
          .value
          .trim();


      if (
        !name ||
        !email ||
        !address
      ) {

        alert(
          "Merci de remplir votre nom, votre email et votre adresse."
        );

        return;

      }


      let orderText =
        "Bonjour Aloïs Design,%0D%0A%0D%0A";

      orderText +=
        "Je souhaite passer la commande suivante :%0D%0A%0D%0A";


      let total =
        0;


      cart.forEach(
        item => {

          const quantity =
            Number(item.quantity) || 1;

          const price =
            Number(item.price) || 0;

          const itemTotal =
            price * quantity;


          total +=
            itemTotal;


          orderText +=
            "- " +
            encodeURIComponent(
              item.name
            ) +
            " x" +
            quantity +
            " = " +
            encodeURIComponent(
              formatPrice(itemTotal)
            ) +
            "%0D%0A";


          if (
            item.customization
          ) {

            if (
              item.customization.text
            ) {

              orderText +=
                "  Texte : " +
                encodeURIComponent(
                  item.customization.text
                ) +
                "%0D%0A";

            }


            if (
              item.customization.color
            ) {

              orderText +=
                "  Couleur : " +
                encodeURIComponent(
                  item.customization.color
                ) +
                "%0D%0A";

            }


            if (
              item.customization.description
            ) {

              orderText +=
                "  Personnalisation : " +
                encodeURIComponent(
                  item.customization.description
                ) +
                "%0D%0A";

            }

          }

        }
      );


      orderText +=
        "%0D%0ATotal produits : " +
        encodeURIComponent(
          formatPrice(total)
        );


      orderText +=
        "%0D%0A%0D%0A";


      orderText +=
        "Nom / prénom : " +
        encodeURIComponent(name) +
        "%0D%0A";


      orderText +=
        "Email : " +
        encodeURIComponent(email) +
        "%0D%0A";


      orderText +=
        "Adresse : " +
        encodeURIComponent(address) +
        "%0D%0A";


      if (message) {

        orderText +=
          "Message : " +
          encodeURIComponent(message) +
          "%0D%0A";

      }


      orderText +=
        "%0D%0AMerci.";


      window.location.href =
        "mailto:aloisryckebuschvandaele@gmail.com" +
        "?subject=" +
        encodeURIComponent(
          "Commande Aloïs Design"
        ) +
        "&body=" +
        orderText;

    }


    /* =========================
       PROTECTION HTML
    ========================== */

    function escapeHTML(text) {

      return String(text)
        .replace(
          /&/g,
          "&amp;"
        )
        .replace(
          /</g,
          "&lt;"
        )
        .replace(
          />/g,
          "&gt;"
        )
        .replace(
          /"/g,
          "&quot;"
        )
        .replace(
          /'/g,
          "&#039;"
        );

    }


    /* =========================
       INITIALISATION
    ========================== */

    renderCart();


    window.addEventListener(
      "storage",
      renderCart
    );

  </script>

</body>
</html>
