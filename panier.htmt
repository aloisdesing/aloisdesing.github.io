<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Panier - Alois Design</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, sans-serif;
      background: #f5f5f5;
      color: #222;
    }

    header {
      background: #111;
      color: white;
      text-align: center;
      padding: 25px 15px;
    }

    header h1 {
      font-size: 30px;
    }

    header p {
      color: #ccc;
      margin-top: 5px;
    }

    .container {
      width: 92%;
      max-width: 900px;
      margin: 40px auto;
    }

    h2 {
      text-align: center;
      font-size: 30px;
      margin-bottom: 30px;
    }

    .vide {
      background: white;
      padding: 45px 20px;
      border-radius: 18px;
      text-align: center;
      box-shadow: 0 5px 20px rgba(0,0,0,0.08);
    }

    .vide .icone {
      font-size: 55px;
      margin-bottom: 15px;
    }

    .vide p {
      color: #666;
      margin: 10px 0 25px;
    }

    .produit {
      background: white;
      padding: 20px;
      margin-bottom: 15px;
      border-radius: 16px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.07);

      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
    }

    .infos {
      flex: 1;
    }

    .infos h3 {
      font-size: 20px;
      margin-bottom: 8px;
    }

    .details {
      color: #666;
      font-size: 14px;
      line-height: 1.7;
    }

    .prix {
      text-align: right;
      min-width: 120px;
    }

    .sous-total {
      font-size: 21px;
      font-weight: bold;
      margin-bottom: 10px;
    }

    .supprimer {
      background: #eee;
      border: none;
      padding: 8px 12px;
      border-radius: 8px;
      cursor: pointer;
      font-weight: bold;
    }

    .supprimer:hover {
      background: #ddd;
    }

    .resume {
      background: white;
      padding: 25px;
      margin-top: 25px;
      border-radius: 18px;
      box-shadow: 0 5px 20px rgba(0,0,0,0.08);
    }

    .ligne {
      display: flex;
      justify-content: space-between;
      margin-bottom: 12px;
    }

    .grand-total {
      border-top: 1px solid #ddd;
      padding-top: 18px;
      margin-top: 15px;

      font-size: 25px;
      font-weight: bold;
    }

    .bouton {
      display: block;
      width: 100%;
      padding: 15px;
      margin-top: 15px;

      border-radius: 10px;
      border: none;

      text-align: center;
      text-decoration: none;

      font-size: 16px;
      font-weight: bold;

      cursor: pointer;
    }

    .principal {
      background: #111;
      color: white;
    }

    .secondaire {
      background: #eee;
      color: #111;
    }

    .vider {
      display: block;
      margin: 18px auto 0;

      background: none;
      border: none;

      color: #777;
      text-decoration: underline;

      cursor: pointer;
    }

    footer {
      background: #111;
      color: #ccc;
      text-align: center;
      padding: 25px 15px;
      margin-top: 50px;
    }

    footer a {
      color: white;
      text-decoration: none;
    }

    @media (max-width: 600px) {

      .produit {
        flex-direction: column;
        align-items: flex-start;
      }

      .prix {
        width: 100%;
        text-align: left;
      }

      .grand-total {
        font-size: 22px;
      }

    }
  </style>
</head>


<body>

<header>

  <h1>Alois Design</h1>

  <p>Votre panier</p>

</header>


<main class="container">

  <h2>🛒 Mon panier</h2>

  <div id="panier"></div>

</main>


<footer>

  <p>Alois Design</p>

  <p>
    <a href="mailto:aloisryckebuschvandaele@gmail.com">
      aloisryckebuschvandaele@gmail.com
    </a>
  </p>

  <p>
    © 2026 Alois Design
  </p>

</footer>


<script>

  /*
   * RÉCUPÉRATION DU PANIER
   */

  let panier =
    JSON.parse(localStorage.getItem("panier")) || [];


  /*
   * AFFICHAGE
   */

  function afficherPanier() {

    const zone =
      document.getElementById("panier");


    /*
     * PANIER VIDE
     */

    if (panier.length === 0) {

      zone.innerHTML = `

        <div class="vide">

          <div class="icone">
            🛒
          </div>

          <h3>
            Votre panier est vide
          </h3>

          <p>
            Ajoutez un produit pour commencer.
          </p>

          <a
            href="impression-3D.html"
            class="bouton principal"
          >
            Voir nos produits
          </a>

        </div>

      `;

      return;
    }


    let contenu = "";

    let total = 0;


    /*
     * PRODUITS
     */

    panier.forEach((produit, index) => {

      const prix =
        Number(produit.prix) || 0;

      const quantite =
        Number(produit.quantite) || 1;

      const sousTotal =
        prix * quantite;


      total += sousTotal;


      let details = "";


      /*
       * Détails porte-clé
       */

      if (produit.texte) {

        details +=
          "Texte : " +
          escapeHTML(produit.texte) +
          "<br>";

      }


      if (produit.couleur) {

        details +=
          "Couleur : " +
          escapeHTML(produit.couleur) +
          "<br>";

      }


      if (produit.taille) {

        details +=
          "Taille : " +
          escapeHTML(produit.taille) +
          "<br>";

      }


      if (produit.imageNom) {

        details +=
          "Dessin : " +
          escapeHTML(produit.imageNom) +
          "<br>";

      }


      contenu += `

        <div class="produit">

          <div class="infos">

            <h3>
              ${escapeHTML(
                produit.nom || "Produit"
              )}
            </h3>

            <div class="details">

              ${details}

              Quantité :
              ${quantite}

              <br>

              Prix unitaire :
              ${formatPrix(prix)}

            </div>

          </div>


          <div class="prix">

            <div class="sous-total">
              ${formatPrix(sousTotal)}
            </div>

            <button
              class="supprimer"
              onclick="supprimer(${index})"
            >
              Supprimer
            </button>

          </div>

        </div>

      `;

    });


    /*
     * RÉSUMÉ
     */

    contenu += `

      <div class="resume">

        <div class="ligne">

          <span>
            Sous-total
          </span>

          <strong>
            ${formatPrix(total)}
          </strong>

        </div>


        <div class="ligne">

          <span>
            Livraison
          </span>

          <span>
            À calculer
          </span>

        </div>


        <div class="ligne grand-total">

          <span>
            Total
          </span>

          <span>
            ${formatPrix(total)}
          </span>

        </div>


        <a
          href="impression-3D.html"
          class="bouton secondaire"
        >
          ← Continuer mes achats
        </a>


        <button
          class="bouton principal"
          onclick="commander()"
        >
          Commander
        </button>


        <button
          class="vider"
          onclick="viderPanier()"
        >
          Vider le panier
        </button>

      </div>

    `;


    zone.innerHTML = contenu;

  }


  /*
   * SUPPRIMER
   */

  function supprimer(index) {

    panier.splice(index, 1);

    sauvegarder();

    afficherPanier();

  }


  /*
   * VIDER
   */

  function viderPanier() {

    if (
      confirm(
        "Voulez-vous vraiment vider votre panier ?"
      )
    ) {

      panier = [];

      sauvegarder();

      afficherPanier();

    }

  }


  /*
   * SAUVEGARDER
   */

  function sauvegarder() {

    localStorage.setItem(
      "panier",
      JSON.stringify(panier)
    );

  }


  /*
   * FORMAT PRIX
   */

  function formatPrix(prix) {

    return (
      prix
        .toFixed(2)
        .replace(".", ",") +
      " €"
    );

  }


  /*
   * PROTECTION HTML
   */

  function escapeHTML(texte) {

    return String(texte)

      .replace(/&/g, "&amp;")

      .replace(/</g, "&lt;")

      .replace(/>/g, "&gt;")

      .replace(/"/g, "&quot;")

      .replace(/'/g, "&#039;");

  }


  /*
   * COMMANDER
   */

  function commander() {

    if (panier.length === 0) {

      alert(
        "Votre panier est vide."
      );

      return;

    }


    /*
     * PAGE DE COMMANDE
     */

    window.location.href =
      "commande.html";

  }


  /*
   * LANCEMENT
   */

  afficherPanier();

</script>

</body>
</html>
